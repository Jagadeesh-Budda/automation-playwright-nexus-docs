  {
    "id": "05-js-ts-async",
    "title": "0.5: Async/Await & Promises",
    "url": "courses/playwright/05-js-ts-async",
    "group": "🌱 MODULE 0: JS/TS FOR AUTOMATION",
    "level": 0,
    "weight": 5,
    "meta": {
      "time": "15 mins",
      "type": "Concept",
      "outcome": "Understand the event loop."
    },
    "objectives": [
      {
        "id": "js_async",
        "title": "Use async and await."
      }
    ],
    "tasks": [
      {
        "title": "Sandbox: Fix the Flaky Script",
        "hint": "Add 'await' to simulateNetworkCall()",
        "rules": [
          {
            "type": "ast_node",
            "value": "AwaitExpression",
            "required": true
          },
          {
            "type": "ast_node",
            "value": "CallExpression",
            "required": true
          }
        ]
      }
    ],
    "quizMapping": [],
    "quizPool": {
      "Easy": [
        {
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "Your test interacts with a slow loading checkout page. You write `page.click('#submit')`.",
          "q": "Why is the test failing unpredictably on CI but passing locally?",
          "options": [
            "You forgot the 'await' keyword, so the script isn't waiting for the click promise to resolve before moving to assertions",
            "The CI server needs more RAM",
            "You must use a callback",
            "The click function is synchronous in Playwright"
          ],
          "a": "You forgot the 'await' keyword, so the script isn't waiting for the click promise to resolve before moving to assertions",
          "explanation": "Nearly all Playwright actions are asynchronous Promises. Without `await`, Node.js instantly moves to the next line of code, causing race conditions."
        },
        {
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "async function getData() {\n  return 'done';\n}\nconst result = getData();",
          "q": "What is the value of `result`?",
          "options": [
            "A Promise object",
            "'done'",
            "undefined",
            "null"
          ],
          "a": "A Promise object",
          "explanation": "Any function marked as `async` always returns a Promise, even if you explicitly return a string. You must `await` the function call to get the string."
        }
      ],
      "Medium": [
        {
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "try {\n  await page.locator('.flaky').click({ timeout: 1000 });\n} catch (e) {\n  console.log('Handled!');\n}",
          "q": "If the locator is not found within 1 second, what happens to the test execution?",
          "options": [
            "The test passes and logs 'Handled!'",
            "The test crashes immediately",
            "Playwright automatically retries",
            "The test hangs forever"
          ],
          "a": "The test passes and logs 'Handled!'",
          "explanation": "The `try/catch` block intercepts the Promise rejection. Since the error is caught and not re-thrown, the test runner considers the execution successful."
        },
        {
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "You need to fetch data from three independent APIs to set up your test data. Calling them one by one takes 9 seconds.",
          "q": "How can you optimize this setup phase?",
          "options": [
            "Use Promise.all() to trigger all three requests concurrently",
            "Use a generic setTimeout to skip waiting",
            "Combine them into a single synchronous loop",
            "You cannot optimize it; Promises must run in order"
          ],
          "a": "Use Promise.all() to trigger all three requests concurrently",
          "explanation": "`Promise.all()` allows multiple asynchronous operations to execute in parallel, resolving only when all of them have finished, massively reducing test execution time."
        }
      ],
      "Hard": [
        {
          "type": "code-analysis",
          "difficulty": "hard",
          "code": "[1, 2, 3].forEach(async (id) => {\n  await page.goto(`/item/${id}`);\n});\nawait expect(page.locator('.header')).toBeVisible();",
          "q": "Why is this code a dangerous anti-pattern?",
          "options": [
            "Array.forEach does not wait for async callbacks, so the assertion runs immediately before the navigations finish",
            "Playwright forbids navigating in loops",
            "The await inside forEach causes a syntax error",
            "It creates an infinite loop"
          ],
          "a": "Array.forEach does not wait for async callbacks, so the assertion runs immediately before the navigations finish",
          "explanation": "`forEach` is synchronous and ignores promises returned by its callback. To run async operations in sequence, you must use a standard `for...of` loop."
        }
      ]
    },
    "icon": "🌱",
    "slug": "05-js-ts-async",
    "learningPaths": [
      "foundations",
      "enterprise"
    ],
    "category": "core",
    "optional": false,
    "industryTags": [],
    "estimatedMinutes": 45,
    "certificateTrack": "Playwright Foundations"
  },
