    },
    "quizPool": {
      "Easy": [
        {
          "objective": "esign_exec",
          "type": "mcq",
          "difficulty": "easy",
          "q": "What defines a 'Multi-Step Approval Flow' in an enterprise application?",
          "options": [
            "A user clicking a button 5 times.",
            "A business process where a single document or record must be sequentially reviewed and electronically signed by multiple distinct users (e.g., Author -> Reviewer -> QA Approver) before it becomes finalized.",
            "A form with multiple input fields.",
            "A test suite with multiple files."
          ],
          "a": "A business process where a single document or record must be sequentially reviewed and electronically signed by multiple distinct users (e.g., Author -> Reviewer -> QA Approver) before it becomes finalized.",
          "explanation": "This is the backbone of regulated industries. Data cannot just be 'saved'. It must traverse a strict, linear state machine governed by separate individuals to ensure absolute quality control and prevent unilateral tampering."
        },
        {
          "objective": "esign_exec",
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "test('QA Review', async ({ page }) => {\n  // 1. Login as Author, create document, sign it.\n  // 2. Logout.\n  // 3. Login as QA, find document, sign it.\n});",
          "q": "Why is performing this entire multi-role workflow through the UI inside a single test considered a severe anti-pattern?",
          "options": [
            "Because the UI is too colorful.",
            "It makes the test incredibly slow, brittle, and monolithic. Logging in and out takes massive amounts of time. The UI should only be used to test the *specific* role under evaluation. The preceding steps should be bypassed.",
            "Because you cannot log out in Playwright.",
            "Because QA cannot sign documents."
          ],
          "a": "It makes the test incredibly slow, brittle, and monolithic. Logging in and out takes massive amounts of time. The UI should only be used to test the *specific* role under evaluation. The preceding steps should be bypassed.",
          "explanation": "UI testing is the most expensive operation in automation. If your goal is to test the 'QA Approval' button, wasting 30 seconds driving the browser through the 'Author Creation' phase is a catastrophic waste of CI resources."
        },
        {
          "objective": "esign_exec",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You need to test the 'Final Approver' step of a 5-step workflow.",
          "q": "How do you architect the test to instantly place the application into 'Step 5' state so the UI test can begin immediately?",
          "options": [
            "Click through Steps 1-4 very fast.",
            "Use a custom `test.extend` Fixture that executes raw API calls directly to the backend database to instantly spawn a document, forge the first 4 signatures via API, and return the `documentId`. The test then simply navigates to `/doc/123`.",
            "Use a pre-existing document from yesterday.",
            "Ask a developer to change the database."
          ],
          "a": "Use a custom `test.extend` Fixture that executes raw API calls directly to the backend database to instantly spawn a document, forge the first 4 signatures via API, and return the `documentId`. The test then simply navigates to `/doc/123`.",
          "explanation": "This is Data Seeding via API. You use the fast, reliable backend API to mathematically force the system into the exact prerequisite state required for the UI test. This reduces a 2-minute test to 5 seconds."
