          "objective": "api_request",
          "type": "code-analysis",
          "difficulty": "hard",
          "code": "test('Test API', async ({ request }) => {\n  const res = await request.post('/api/slow-process', { timeout: 500 });\n  expect(res.ok()).toBeTruthy();\n});",
