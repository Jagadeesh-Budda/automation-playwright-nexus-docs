    "quizPool": {
      "Easy": [
        {
          "objective": "debugging_workflow",
          "type": "mcq",
          "difficulty": "easy",
          "q": "When a Playwright test fails in CI, what is the absolute best artifact to download to visually and technically understand exactly what happened?",
          "options": [
            "The Playwright Trace file (`trace.zip`).",
            "The standard terminal output text.",
            "The Chromium error log.",
            "The `package-lock.json` file."
          ],
          "a": "The Playwright Trace file (`trace.zip`).",
          "explanation": "The Playwright Trace is a revolutionary debugging artifact. It captures a full timeline of DOM snapshots, network requests, console logs, and action execution, allowing you to visually 'time travel' through the test exactly as it ran in CI."
        },
        {
          "objective": "debugging_workflow",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You are writing a test locally and want to interactively explore the DOM, pause execution, and try out different locators in real-time.",
          "q": "Which Playwright CLI command launches the test in interactive debug mode?",
          "options": [
            "npx playwright test --debug",
            "npx playwright test --inspect",
            "npx playwright test --interactive",
            "npx playwright debug"
          ],
          "a": "npx playwright test --debug",
          "explanation": "The `--debug` flag automatically opens the Playwright Inspector, pauses the test on the very first line, opens a headed browser, and allows you to step through the code line-by-line while evaluating locators."
        },
        {
          "objective": "debugging_workflow",
          "type": "multi-select",
          "difficulty": "easy",
          "scenario": "You have a test that runs perfectly on your machine, but fails randomly on the CI server. You suspect a race condition.",
          "q": "Which of the following local debugging techniques can help expose hidden race conditions? (Select all that apply)",
          "options": [
            "Run the test with the `--repeat-each=100` flag to force it to run sequentially 100 times to catch the flake.",
            "Run the test on a slower machine or use CPU throttling to mimic a weak CI server.",
            "Add `page.waitForTimeout(10000)` to fix the test.",
            "Ignore it until it fails 3 times in a row."
          ],
          "a": [
            "Run the test with the `--repeat-each=100` flag to force it to run sequentially 100 times to catch the flake.",
            "Run the test on a slower machine or use CPU throttling to mimic a weak CI server."
          ],
          "explanation": "Flaky tests are usually caused by the application or environment being slower than expected. Stress-testing the file locally via `--repeat-each` or artificially slowing down your machine are standard architectural techniques to surface the race condition."
        },
        {
          "objective": "debugging_workflow",
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "test('verify modal', async ({ page }) => {\n  await page.click('#open');\n  await page.pause();\n  await expect(page.locator('.modal')).toBeVisible();\n});",
          "q": "What is the specific function of the `page.pause()` command in this script?",
          "options": [
            "It halts execution permanently and opens the Playwright Inspector, allowing the developer to manually interact with the browser state at that exact moment before continuing.",
            "It pauses the test for 5 seconds.",
            "It causes the browser to reload.",
            "It skips the assertion."
          ],
          "a": "It halts execution permanently and opens the Playwright Inspector, allowing the developer to manually interact with the browser state at that exact moment before continuing.",
          "explanation": "`page.pause()` is an explicit breakpoint. It is incredibly useful for stopping a fast-moving test right before a complex interaction so you can manually inspect the DOM tree or test locators in the console."
        },
        {
          "objective": "debugging_workflow",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You downloaded a `trace.zip` file from your Jenkins server.",
          "q": "How do you view this file locally?",
          "options": [
            "Unzip it and double-click the `index.html` file.",
            "Run `npx playwright show-trace path/to/trace.zip` in your terminal.",
            "Open it in Microsoft Excel.",
            "Upload it to GitHub."
          ],
          "a": "Run `npx playwright show-trace path/to/trace.zip` in your terminal.",
          "explanation": "The `show-trace` command boots a local instance of the Playwright Trace Viewer web application and feeds it the encrypted/zipped data, bypassing browser CORS restrictions that occur if you just try to unzip it."
        }
      ],
      "Medium": [
        {
          "objective": "debugging_workflow",
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "await page.locator('.btn-primary').click();",
          "q": "The test fails on this line with the error: `Error: strict mode violation: locator('.btn-primary') resolved to 4 elements`. What is the architectural rule being enforced here?",
          "options": [
            "Playwright forces all locators to be unique. If a locator matches multiple elements, Playwright refuses to guess which one you meant and throws an error to prevent unintentional interactions.",
            "The `.btn-primary` class is not defined in the CSS.",
            "The element is hidden.",
            "You must use an XPath instead."
          ],
          "a": "Playwright forces all locators to be unique. If a locator matches multiple elements, Playwright refuses to guess which one you meant and throws an error to prevent unintentional interactions.",
          "explanation": "This is Playwright's 'Strict Mode'. It is a core safety feature. Selenium would blindly click the first element it found. Playwright throws a hard error, forcing the SDET to refine the locator (e.g., `locator('.btn-primary').first()` or adding a text filter) to ensure deterministic execution."
        },
        {
          "objective": "debugging_workflow",
          "type": "multi-select",
          "difficulty": "medium",
          "scenario": "You are utilizing the VS Code Playwright Extension to debug a test.",
          "q": "Which of the following debugging actions can be performed entirely inside the VS Code IDE without touching the CLI? (Select all that apply)",
          "options": [
            "Setting visual breakpoints by clicking the gutter next to the line numbers.",
            "Running a single test by clicking the 'Play' button next to the test title.",
            "Opening the Trace Viewer for a failed test.",
            "Generating a PDF report of the execution.",
            "Recording new code via Codegen."
          ],
          "a": [
            "Setting visual breakpoints by clicking the gutter next to the line numbers.",
            "Running a single test by clicking the 'Play' button next to the test title.",
            "Opening the Trace Viewer for a failed test.",
            "Recording new code via Codegen."
          ],
          "explanation": "The Playwright VS Code extension provides a fully integrated GUI for almost the entire CLI feature set, including debugging, breakpoints, trace viewing, and codegen. PDF reports are not natively supported."
        },
        {
          "objective": "debugging_workflow",
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "Your test clicks a button to submit a form, but nothing happens. The test eventually times out on the next assertion. The UI looks correct, and the button is clearly visible.",
          "q": "When looking at the Trace Viewer, which specific tab will instantly reveal if the frontend application threw an unhandled React exception when the button was clicked?",
          "options": [
            "The Network Tab",
            "The Console Tab",
            "The Source Tab",
            "The Call Tab"
          ],
          "a": "The Console Tab",
          "explanation": "The Console tab in the Trace Viewer captures all native browser `console.log`, `console.error`, and uncaught exceptions. If clicking a button causes the frontend framework to crash internally, the red error trace will be permanently captured here."
        },
        {
          "objective": "debugging_workflow",
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "test.use({ trace: 'retain-on-failure', video: 'on-first-retry' });",
          "q": "What is the architectural and financial justification for configuring artifacts this way in an enterprise CI environment, rather than setting both to 'on'?",
          "options": [
            "Traces and videos consume massive amounts of CPU, RAM, and Disk Space. Recording them for every passing test is a waste of infrastructure money. Generating them only when a test fails or retries optimizes resources while preserving debugging capability.",
            "Playwright cannot record videos for passing tests.",
            "Tracing is incompatible with parallel execution.",
            "It forces the tests to run faster."
          ],
          "a": "Traces and videos consume massive amounts of CPU, RAM, and Disk Space. Recording them for every passing test is a waste of infrastructure money. Generating them only when a test fails or retries optimizes resources while preserving debugging capability.",
          "explanation": "At an enterprise scale (10,000+ tests), retaining traces for green runs can consume hundreds of gigabytes of storage per pipeline run. The `retain-on-failure` pattern ensures you only pay the storage cost when you actually need to debug a failure."
        },
        {
          "objective": "debugging_workflow",
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "You are writing a test and struggling to find a locator for a specific SVG icon. You open the browser DevTools (F12) while paused in debug mode.",
          "q": "How can you leverage the browser's native DevTools Console to test Playwright locators?",
          "options": [
            "Type `playwright.$('css-selector')` into the Chrome console.",
            "Type `document.querySelector('css-selector')` and hope it matches.",
            "Type `playwright.locator('css-selector')` into the console.",
            "You cannot use Playwright specific engines (like role or text locators) inside the Chrome console."
          ],
          "a": "Type `playwright.$('css-selector')` into the Chrome console.",
          "explanation": "When Playwright is attached to a browser, it injects a global `playwright` object into the DOM. By typing `playwright.$('text=Submit')` or `playwright.$('role=button')` directly into the Chrome console, you can evaluate Playwright's custom engine locators visually."
        }
      ],
      "Hard": [
        {
          "objective": "debugging_workflow",
          "type": "code-analysis",
          "difficulty": "hard",
          "code": "import debug from 'debug';\nconst log = debug('app:tests:login');\n\ntest('login flow', async ({ page }) => {\n  log('Navigating to homepage');\n  await page.goto('/');\n  // ...\n});",
          "q": "A senior architect mandates the use of the `debug` npm package instead of `console.log`. How do you mathematically expose these logs in the CI pipeline without modifying the code?",
          "options": [
            "Inject the environment variable `DEBUG=app:tests:*` into the CI runner. The `debug` package uses this to conditionally render the hidden logs, keeping standard output clean while providing deep observability when needed.",
            "Run Playwright with the `--debug` flag.",
            "Open the Trace Viewer.",
            "Use the `console.log` interceptor."
          ],
          "a": "Inject the environment variable `DEBUG=app:tests:*` into the CI runner. The `debug` package uses this to conditionally render the hidden logs, keeping standard output clean while providing deep observability when needed.",
          "explanation": "Enterprise pipelines rely on structured, toggleable observability. `console.log` pollutes standard output permanently. The `debug` package provides namespace-driven logging. By default, it is completely silent. When an SDET needs to investigate a CI failure, they inject `DEBUG=app:*` into the pipeline variables, turning on massive telemetry instantly."
        },
        {
          "objective": "debugging_workflow",
          "type": "scenario",
          "difficulty": "hard",
          "scenario": "A test fails in CI on step 5. The Trace Viewer reveals that the DOM Snapshot for step 5 is completely blank (white screen). However, the Network tab shows all APIs returning 200 OK. The application is a React SPA.",
          "q": "Based on this specific Trace fingerprint, what is the architectural root cause of the failure?",
          "options": [
            "The backend database crashed.",
            "Playwright failed to capture the snapshot.",
            "A fatal JavaScript exception occurred in the React rendering cycle (e.g., trying to read `.length` of undefined). The frontend framework crashed, resulting in the 'White Screen of Death', which Playwright faithfully recorded.",
            "The test timed out."
          ],
          "a": "A fatal JavaScript exception occurred in the React rendering cycle (e.g., trying to read `.length` of undefined). The frontend framework crashed, resulting in the 'White Screen of Death', which Playwright faithfully recorded.",
          "explanation": "This is a classic SPA failure signature. If the network is healthy but the DOM instantly vanishes or goes white, it mathematically proves the frontend client crashed during rendering. The SDET should pivot immediately to the Console tab in the Trace to extract the React stack trace to give to the developers."
        },
        {
          "objective": "debugging_workflow",
          "type": "multi-select",
          "difficulty": "hard",
          "scenario": "You are writing a pipeline script to debug a persistent Playwright runner crash (`SIGKILL` out of memory) on an underpowered AWS Jenkins node.",
          "q": "Which environment variables dramatically alter Playwright's internal execution architecture to help diagnose or mitigate memory crashes? (Select all that apply)",
          "options": [
            "PWDEBUG=1",
            "PLAYWRIGHT_HTML_REPORT=1",
            "DEBUG=pw:api",
            "NODE_OPTIONS=--max-old-space-size=4096",
            "PLAYWRIGHT_BROWSERS_PATH=0"
          ],
          "a": [
            "DEBUG=pw:api",
            "NODE_OPTIONS=--max-old-space-size=4096"
          ],
          "explanation": "`DEBUG=pw:api` instructs Playwright to print every single internal CDP command it executes, providing immense logging. `NODE_OPTIONS=--max-old-space-size=4096` expands the V8 memory heap limit for the Node.js runner process, often preventing OOM crashes on constrained nodes."
        },
        {
          "objective": "debugging_workflow",
          "type": "code-analysis",
          "difficulty": "hard",
          "code": "await page.route('**/*', route => {\n  console.log(route.request().url());\n  route.continue();\n});",
          "q": "An SDET implements this globally to log all network traffic for debugging. Suddenly, execution time inflates by 400%, and tests start timing out. What is the architectural bottleneck?",
          "options": [
            "Using `**/*` intercepts absolutely every asset (images, fonts, CSS, JS). Routing every single sub-resource from the Chromium engine through the Node.js event loop and back creates a massive IPC (Inter-Process Communication) bottleneck.",
            "Playwright disables caching when `page.route` is active.",
            "The `console.log` method is asynchronous and slow.",
            "`route.continue()` modifies the headers automatically."
          ],
          "a": "Using `**/*` intercepts absolutely every asset (images, fonts, CSS, JS). Routing every single sub-resource from the Chromium engine through the Node.js event loop and back creates a massive IPC (Inter-Process Communication) bottleneck.",
          "explanation": "Network interception is expensive. Passing every single 1kb image request across the WebSocket boundary from Browser -> Node -> Browser crushes the CPU. Interception should always be strictly scoped to specific endpoints (e.g., `**/api/**`) to preserve performance."
        },
        {
          "objective": "debugging_workflow",
          "type": "scenario",
          "difficulty": "hard",
          "scenario": "Your tests involve interacting with a complex, 3rd-party mapping library (like Mapbox or Google Maps) rendered entirely inside an HTML `<canvas>` element. Standard Playwright locators cannot see inside a canvas.",
          "q": "What is the industry-standard Playwright debugging and automation strategy for asserting state inside a compiled Canvas?",
          "options": [
            "Use XPath.",
            "Use `page.evaluate()` to tap directly into the mapping library's global window object (e.g., `window.map.getZoom()`) and extract the mathematical state directly, bypassing the DOM entirely.",
            "Use Playwright's built-in `getByCanvas()` locator.",
            "You cannot automate canvas applications."
          ],
          "a": "Use `page.evaluate()` to tap directly into the mapping library's global window object (e.g., `window.map.getZoom()`) and extract the mathematical state directly, bypassing the DOM entirely.",
          "explanation": "A `<canvas>` is an opaque pixel grid. Playwright cannot read it. The enterprise solution is to coordinate with developers to expose the underlying data engine to the `window` object. You then use Playwright's JavaScript Execution Context (`page.evaluate`) to read the raw data model, ensuring perfect deterministic assertions."
        }
      ]
