  {
    "id": "44-fundamentals-arch",
    "title": "8.5: Industrial Folder Design",
    "url": "courses/playwright/44-fundamentals-arch",
    "group": "🧱 MODULE 8: ENTERPRISE PRACTICES",
    "level": 6,
    "weight": 15,
    "meta": {
      "time": "15 mins",
      "type": "Architecture",
      "outcome": "Adopt the 4-layer project structure"
    },
    "objectives": [
      {
        "id": "project_structure",
        "title": "Understand the Enterprise Folder Mapping"
      }
    ],
    "tasks": [],
    "quizMapping": [
      {
        "objective": "project_structure",
        "weight": 100
      }
    ],
    "spec": {
      "layers": [
        "tests",
        "pages",
        "components",
        "entities"
      ]
    },
    "quizPool": {
      "Easy": [
        {
          "objective": "project_structure",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You are assigned to write tests for a new e-commerce checkout flow. You need to create a class that strictly handles the locators and actions for the 'Checkout' screen.",
          "q": "In which architectural layer does this class belong?",
          "options": [
            "/pages",
            "/tests",
            "/components",
            "/entities"
          ],
          "a": "/pages",
          "explanation": "The `/pages` layer is specifically reserved for Page Objects. These classes encapsulate the locators, DOM interactions, and workflows for a specific screen or URL route."
        },
        {
          "objective": "project_structure",
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "import { test, expect } from '@playwright/test';\nimport { LoginPage } from '../pages/LoginPage';\n\ntest('login success', async ({ page }) => {\n  const login = new LoginPage(page);\n  await login.navigate();\n  await login.submit('admin', 'password123');\n  await expect(page).toHaveURL('/dashboard');\n});",
          "q": "Where should this specific file be stored in the enterprise folder structure?",
          "options": [
            "/tests",
            "/src/tests",
            "/pages",
            "/specs"
          ],
          "a": "/tests",
          "explanation": "Playwright test orchestration files (files containing the `test()` blocks and assertions) belong strictly in the `/tests` folder. This is the top layer of the architecture."
        },
        {
          "objective": "project_structure",
          "type": "multi-select",
          "difficulty": "easy",
          "scenario": "You are organizing a massive enterprise repository.",
          "q": "Which of the following folders make up the core 4-Layer architectural design pattern taught in this academy? (Select all that apply)",
          "options": [
            "tests",
            "pages",
            "components",
            "entities",
            "controllers"
          ],
          "a": [
            "tests",
            "pages",
            "components",
            "entities"
          ],
          "explanation": "The architecture strictly uses `tests` (orchestration), `pages` (page objects), `components` (reusable UI fragments), and `entities` (data models). Controllers are a backend MVC concept."
        },
        {
          "objective": "project_structure",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You need to create a `User` class that defines properties like `firstName`, `email`, and `password`, along with a method to generate a randomized mock user.",
          "q": "Which architectural layer is responsible for managing data structures like this?",
          "options": [
            "/entities",
            "/pages",
            "/utils",
            "/fixtures"
          ],
          "a": "/entities",
          "explanation": "The `/entities` layer is dedicated to business logic and data models (Entities, Data Transfer Objects). It handles data generation entirely independent of the UI or DOM."
        },
        {
          "objective": "project_structure",
          "type": "mcq",
          "difficulty": "easy",
          "q": "Why is it important to separate `/pages` from `/tests` instead of writing locators directly inside the test files?",
          "options": [
            "To promote reusability, so when a locator changes, you only update it in one place instead of across 50 test files.",
            "Because Playwright throws an error if locators are in the test file.",
            "To make the tests run faster in parallel.",
            "To satisfy the TypeScript compiler requirements."
          ],
          "a": "To promote reusability, so when a locator changes, you only update it in one place instead of across 50 test files.",
          "explanation": "The core tenet of the Page Object Model (POM) is reducing duplication and isolating maintenance. By keeping locators in `/pages`, UI changes require a single update rather than massive refactors."
        }
      ],
      "Medium": [
        {
          "objective": "project_structure",
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "export class DashboardPage {\n  constructor(private page: Page) {}\n\n  async verifyWelcomeMessage(username: string) {\n    const message = this.page.locator('.welcome');\n    await expect(message).toHaveText(`Welcome ${username}`);\n  }\n}",
          "q": "A senior architect rejects this pull request. What fundamental architectural rule does this Page Object violate?",
          "options": [
            "Assertions (`expect`) should never reside inside a Page Object; they belong in the Test layer.",
            "The locator should be defined outside the method.",
            "The class is missing an interface implementation.",
            "The method must return a boolean instead of void."
          ],
          "a": "Assertions (`expect`) should never reside inside a Page Object; they belong in the Test layer.",
          "explanation": "Page Objects exist to model state and perform actions. The *Test* layer is responsible for validating that state. If Page Objects contain assertions, they become rigid, less reusable, and test failures become harder to trace."
        },
        {
          "objective": "project_structure",
          "type": "multi-select",
          "difficulty": "medium",
          "scenario": "A website features a complex 'Date Picker' widget. This exact widget appears on the Flight Search page, the Hotel Search page, and the Car Rental page.",
          "q": "What is the correct architectural approach to model this widget? (Select all that apply)",
          "options": [
            "Create a `DatePickerComponent` class inside `/components`.",
            "Instantiate `DatePickerComponent` as a property inside the Flight, Hotel, and Car Page Objects.",
            "Duplicate the Date Picker locators inside each Page Object.",
            "Create a huge `BasePage` that contains the Date Picker locators, and have all pages extend it."
          ],
          "a": [
            "Create a `DatePickerComponent` class inside `/components`.",
            "Instantiate `DatePickerComponent` as a property inside the Flight, Hotel, and Car Page Objects."
          ],
          "explanation": "This demonstrates 'Composition over Inheritance'. Reusable UI fragments go in `/components`. Those components are then instantiated as properties (composed) inside the `/pages` that use them. Massive BasePages lead to inheritance hell."
        },
        {
          "objective": "project_structure",
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "A junior developer places a file named `generateToken.ts` into the `/pages` directory. The file makes an HTTP POST request to an authentication API and returns a JWT token.",
          "q": "Why is this architecturally incorrect, and where should it go?",
          "options": [
            "It does not interact with the DOM or a UI page; it belongs in `/utils` or an API layer.",
            "The file extension should be `.js`; it belongs in `/pages`.",
            "It belongs in `/components` because it is a reusable fragment.",
            "It belongs in `/tests` because it executes logic."
          ],
          "a": "It does not interact with the DOM or a UI page; it belongs in `/utils` or an API layer.",
          "explanation": "The `/pages` layer is strictly for modeling UI screens via the DOM. Utilities for network requests, database seeding, or cryptography belong in a `/utils` or dedicated API/Services layer."
        },
        {
          "objective": "project_structure",
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "// inside tests/registration.spec.ts\nimport { RegistrationPage } from '../pages/RegistrationPage';\nimport { User } from '../entities/User';\n\ntest('register new user', async ({ page }) => {\n  const user = User.generateRandom();\n  const regPage = new RegistrationPage(page);\n  await regPage.fillForm(user);\n  await regPage.submit();\n});",
          "q": "Evaluate the architectural flow in this test snippet. Is it valid?",
          "options": [
            "Yes, the Test layer correctly orchestrates data from the Entities layer into the Pages layer.",
            "No, the Test layer should not interact with Entities directly.",
            "No, the RegistrationPage should instantiate the User inside its fillForm method.",
            "No, Entities should only be imported inside Page Objects."
          ],
          "a": "Yes, the Test layer correctly orchestrates data from the Entities layer into the Pages layer.",
          "explanation": "This is perfect architecture. The Test acts as the conductor. It gets data (Entities), passes it to the UI handlers (Pages), and executes the workflow. The Page Object remains completely ignorant of how the data was generated."
        },
        {
          "objective": "project_structure",
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "You are defining a new class `HeaderNav` which contains locators for the search bar and the shopping cart icon.",
          "q": "If `HeaderNav` is placed in `/components`, how does a test script interact with it?",
          "options": [
            "The test interacts with the Page Object, and the Page Object delegates actions to its internal `HeaderNav` component.",
            "The test imports `HeaderNav` directly from `/components` and calls its methods.",
