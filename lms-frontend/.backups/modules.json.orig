    "id": "71-component-testing",
    "title": "14.9: Component Testing",
    "url": "courses/playwright/71-component-testing",
    "group": "⚡ MODULE 14: ADVANCED FEATURES",
    "level": 10,
    "weight": 10,
    "meta": {
