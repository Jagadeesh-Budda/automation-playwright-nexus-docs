  {
    "id": "22-duplication-problem",
    "title": "3.4: The Duplication Problem",
    "url": "courses/playwright/22-duplication-problem",
    "group": "📁 MODULE 3: TEST ORGANIZATION",
    "level": 3,
    "weight": 5,
    "meta": {
      "time": "15 mins",
      "type": "Code",
      "outcome": "Experience maintenance pain."
    },
    "objectives": [
      {
        "id": "03d_duplication_problem_obj",
        "title": "Complete 3.4: The Duplication Problem"
      }
    ],
    "tasks": [],
    "quizMapping": [],
    "quizPool": {
      "Easy": [
        {
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "Your test suite has 50 tests. 45 of them start by filling in a login form with the exact same selectors and credentials.",
          "q": "What happens when the engineering team adds a 'Company Name' field to the login page?",
          "options": [
            "You must manually open 45 tests and update the code in every single one",
            "Playwright automatically updates them using AI",
            "The tests will continue passing because Playwright ignores new fields",
            "The pipeline deletes the tests"
          ],
          "a": "You must manually open 45 tests and update the code in every single one",
          "explanation": "Code duplication leads to severe maintenance overhead. A single UI change breaks everything and requires an arduous refactoring effort."
        },
        {
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "test('A', async () => { await login(); });\ntest('B', async () => { await login(); });",
          "q": "What architectural concept aims to resolve this exact duplication?",
          "options": [
            "Page Object Model (POM) and Fixtures",
            "Serial execution mode",
            "Web-first assertions",
            "Using global variables"
          ],
          "a": "Page Object Model (POM) and Fixtures",
          "explanation": "Abstracting repeated logic into POMs or custom fixtures is the standard enterprise approach to achieving DRY (Don't Repeat Yourself) code."
        }
      ],
      "Medium": [
        {
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "A junior SDET proposes moving all shared logic into a single massive `test.beforeEach` block at the top of a huge test file to avoid duplication.",
          "q": "Why might this be an anti-pattern?",
          "options": [
            "It forces tests that don't need all that setup to run it anyway, increasing execution time and coupling",
            "beforeEach hooks are forbidden in Playwright",
            "It breaks parallelization",
            "It throws a syntax error"
          ],
          "a": "It forces tests that don't need all that setup to run it anyway, increasing execution time and coupling",
          "explanation": "While `beforeEach` is good for local setup, dumping *everything* there creates monolithic, slow tests. Fixtures are preferred because they only execute when explicitly requested by a test."
        },
        {
          "type": "multi-select",
          "difficulty": "medium",
          "scenario": "You are auditing a test repository for duplication code smells.",
          "q": "Which of the following are strong indicators of the 'Duplication Problem'? (Select all that apply)",
          "options": [
            "The exact same CSS selector string appears in 10 different files",
            "Multiple tests share the same 15 lines of setup code",
            "Every test starts with `await page.goto('/')`",
            "All tests use `expect()`"
          ],
          "a": [
            "The exact same CSS selector string appears in 10 different files",
            "Multiple tests share the same 15 lines of setup code"
          ],
          "explanation": "Duplicated strings (locators) and heavy duplicated logic (setup) are massive code smells. A single `page.goto` is acceptable, and `expect` is mandatory."
        }
      ],
      "Hard": [
        {
          "type": "scenario",
          "difficulty": "hard",
          "scenario": "You have successfully abstracted your login logic into a reusable utility class. However, tests running in parallel are now sporadically failing with authentication errors.",
          "q": "What architectural mistake likely caused this during refactoring?",
          "options": [
            "The utility class was instantiated globally outside the test blocks, causing workers to share state and overwrite each other's tokens",
            "The utility class used async/await",
            "Playwright cannot handle custom classes in parallel",
            "The timeout was too low"
          ],
          "a": "The utility class was instantiated globally outside the test blocks, causing workers to share state and overwrite each other's tokens",
          "explanation": "When removing duplication, engineers often mistakenly put shared instances in the global file scope. Playwright requires strict isolation; classes must be instantiated *inside* the test block or passed via fixtures."
        }
      ]
    },
    "icon": "📁",
    "slug": "22-duplication-problem",
    "learningPaths": [
      "foundations",
      "enterprise"
    ],
    "category": "core",
    "optional": false,
    "industryTags": [],
    "estimatedMinutes": 45,
    "certificateTrack": "Playwright Foundations"
  },
