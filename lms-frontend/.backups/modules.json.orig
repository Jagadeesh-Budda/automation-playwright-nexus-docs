      "Easy": [
        {
          "objective": "tags_annotations",
          "type": "scenario",
          "difficulty": "easy",
          "q": "How do you 'tag' these tests in the code and execute only them via the CLI?",
          "options": [
            "Use a `// @tag` comment above the test.",
            "Append the tag directly inside the test title string using an `@` symbol (e.g., `test('Login page @smoke', ...)`).",
            "Pass a tag array in the CLI.",
            "Tags are defined in the config file."
          ],
          "a": "Append the tag directly inside the test title string using an `@` symbol (e.g., `test('Login page @smoke', ...)`).",
          "explanation": "Playwright relies on string matching. By embedding tags like `@smoke`, `@regression`, or `@fast` directly into the title string, you create highly searchable, logical groupings across hundreds of disparate files.",
          "scenario": "You only want to run a specific group of 15 tests that verify the critical payment path before a hotfix deployment."
        },
        {
          "objective": "tags_annotations",
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "test('Create Order @P1 @regression', async ({ page }) => { ... });",
          "q": "How do you instruct the Playwright CLI to execute ONLY the tests tagged with `@P1`?",
          "options": [
            "npx playwright test --tag=@P1",
            "npx playwright test --grep @P1",
            "npx playwright test --filter P1",
            "npx playwright test --match @P1"
          ],
          "a": "npx playwright test --grep @P1",
          "explanation": "The `--grep` flag executes a Regular Expression match against the title string of every single test. Only tests where the title matches the regex are executed, making it an incredibly powerful and fast filtering mechanism."
        },
        {
          "objective": "tags_annotations",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You have a test that runs perfectly on Chromium but fails on WebKit because of an active browser bug. You want to skip it only on WebKit.",
          "q": "How do you conditionally skip a test based on the execution environment?",
          "options": [
            "Delete the WebKit project from the config.",
            "Use `test.skip(browserName === 'webkit', 'Skipping due to WebKit Bug #123');` at the top of the test.",
            "Put it in a `try/catch`.",
            "Use `test.fixme()`."
          ],
          "a": "Use `test.skip(browserName === 'webkit', 'Skipping due to WebKit Bug #123');` at the top of the test.",
          "explanation": "Conditional skipping is essential for cross-browser testing. `test.skip` accepts a boolean condition. If true, the test aborts immediately and is explicitly logged in the HTML report as 'Skipped' (Yellow), not 'Failed' (Red)."
        },
        {
          "objective": "tags_annotations",
          "type": "multi-select",
          "difficulty": "easy",
          "scenario": "You are organizing a massive test file with 20 tests. You want to apply the `@auth` tag to all 20 tests.",
          "q": "What is the most efficient way to tag multiple tests without updating 20 strings? (Select all that apply)",
          "options": [
            "Wrap the tests in a `test.describe('Authentication @auth', () => { ... })` block. Tags in a describe block cascade down to all tests inside it.",
            "Use a global variable.",
            "You must update all 20 test titles.",
            "Pass `--tag=@auth` to the `playwright.config.ts`."
          ],
          "a": [
            "Wrap the tests in a `test.describe('Authentication @auth', () => { ... })` block. Tags in a describe block cascade down to all tests inside it."
          ],
          "explanation": "Describe blocks are logical groupings. Any tags placed in the string of the `test.describe` automatically prefix the titles of all child tests, maintaining pristine DRY principles."
        },
        {
          "objective": "tags_annotations",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "A developer writes a new test but hasn't finished the assertions yet. They commit it to the repository. It causes the CI build to fail.",
          "q": "What annotation should the developer have used to indicate the test is under construction and should not fail the pipeline?",
