        {
          "objective": "env_validation",
          "type": "multi-select",
          "difficulty": "medium",
          "scenario": "A developer reports that their local environment is completely broken after pulling a massive architecture refactor from the `main` branch. Files have been renamed, dependencies removed, and tests are failing.",
          "q": "Which of the following commands represent a safe, standard procedure to completely 'nuke and pave' the local environment to a pristine state? (Select all that apply)",
          "options": [
