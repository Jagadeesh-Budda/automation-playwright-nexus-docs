      {
        "id": "00d2_js_ts_objects_obj",
        "title": "Complete 0.4: Objects & Literals"
      }
    ],
    "tasks": [
      {
        "title": "Sandbox: Test Data Objects",
        "hint": "Create loginData and console.log(loginData.password)",
        "rules": [
          {
            "type": "ast_node",
            "value": "ObjectExpression",
            "required": true
          }
        ]
      }
    ],
    "quizMapping": [],
    "quizPool": {
      "Easy": [
        {
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "const user = {\n  name: 'John',\n  role: 'admin'\n};\nconsole.log(user.password);",
          "q": "What will be printed to the console?",
          "options": [
            "undefined",
            "null",
            "Throws a ReferenceError",
            "'' (empty string)"
          ],
          "a": "undefined",
          "explanation": "Accessing a non-existent property on a JavaScript object safely returns `undefined`, it does not throw an error."
        },
        {
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You are testing an API that expects a JSON payload containing user details and an address.",
          "q": "Which data structure is the most appropriate to represent this payload in your test setup?",
          "options": [
            "A nested object literal",
            "A multi-dimensional array",
            "A comma-separated string",
            "A Set"
          ],
          "a": "A nested object literal",
          "explanation": "Object literals `{}` directly map to JSON payloads, making them the standard way to build API request bodies in JS/TS."
        }
      ],
      "Medium": [
        {
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "const config = { timeout: 5000, headless: true };\nconst { headless } = config;",
          "q": "What is the syntax used on the second line called?",
          "options": [
            "Object Destructuring",
            "Object Spreading",
            "Type Casting",
            "Property Assignment"
          ],
          "a": "Object Destructuring",
          "explanation": "Destructuring allows you to unpack properties directly from objects into distinct variables. This is heavily used in Playwright (e.g., `async ({ page }) => {}`)."
        },
        {
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "You have a base configuration object, but for a specific test suite, you need to override just the `timeout` property while keeping the rest.",
          "q": "What is the cleanest ES6 way to achieve this?",
          "options": [
            "Use the spread operator: const newConfig = { ...baseConfig, timeout: 10000 };",
            "Write a for-loop to copy all properties over",
            "Use JSON.parse(JSON.stringify(baseConfig))",
            "Mutate the baseConfig directly"
          ],
          "a": "Use the spread operator: const newConfig = { ...baseConfig, timeout: 10000 };",
          "explanation": "The spread operator `...` safely copies properties into a new object, allowing you to cleanly override specific keys without mutating the original object."
        }
      ],
      "Hard": [
        {
          "type": "code-analysis",
          "difficulty": "hard",
          "code": "const defaultUser = { role: 'guest', metadata: { premium: false } };\nconst testUser = { ...defaultUser };\ntestUser.metadata.premium = true;\nconsole.log(defaultUser.metadata.premium);",
          "q": "What will the console log print, and why?",
          "options": [
            "true; because the spread operator only creates a shallow copy, leaving nested objects referenced.",
            "false; because the spread operator creates a deep clone.",
            "undefined; because metadata is stripped out.",
            "Throws a TypeError."
          ],
          "a": "true; because the spread operator only creates a shallow copy, leaving nested objects referenced.",
          "explanation": "The spread operator only shallow copies. The `metadata` object is still a shared reference. Mutating it in `testUser` mutates it in `defaultUser`, which is a common source of test pollution bugs."
        }
      ]
    },
    "icon": "🌱",
