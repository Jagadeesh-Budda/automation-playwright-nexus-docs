    "quizPool": {
      "Easy": [
        {
          "objective": "api_controller",
          "type": "scenario",
          "difficulty": "easy",
          "q": "How does the API Controller pattern centralize this logic to prevent massive maintenance overhead?",
          "options": [
            "To control the browser's mouse.",
            "To encapsulate raw HTTP `request` logic (URLs, headers, JSON parsing) inside a dedicated class, keeping the actual `.spec.ts` files clean, declarative, and focused entirely on business logic.",
            "To intercept network traffic.",
            "To test the database directly."
          ],
          "a": "To encapsulate raw HTTP `request` logic (URLs, headers, JSON parsing) inside a dedicated class, keeping the actual `.spec.ts` files clean, declarative, and focused entirely on business logic.",
          "explanation": "Test files should not contain raw HTTP paths (`/api/v2/users`) or JSON parsing logic. They should read like English: `await userApi.createUser('Alice')`. The Controller hides the HTTP implementation details.",
          "scenario": "Your tests use `request.post('/api/users')` directly inside the test blocks. When the API endpoint changes to `/v2/users`, you have to update 50 files."
        },
        {
          "objective": "api_controller",
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "export class UserAPI {\n  constructor(private request: APIRequestContext) {}\n  async create(name: string) {\n    const res = await this.request.post('/users', { data: { name } });\n    return res.json();\n  }\n}",
          "q": "How is this Controller architecturally instantiated inside a test?",
          "options": [
            "It instantiates itself.",
            "It must be instantiated by passing the Playwright `request` fixture into its constructor. Ideally, this is done via a custom fixture: `test.extend({ userApi: async ({ request }, use) => { await use(new UserAPI(request)); } })`.",
            "You must use `page.evaluate()`.",
            "You must use Selenium."
          ],
          "a": "It must be instantiated by passing the Playwright `request` fixture into its constructor. Ideally, this is done via a custom fixture: `test.extend({ userApi: async ({ request }, use) => { await use(new UserAPI(request)); } })`.",
          "explanation": "Controllers are just specialized Page Objects for the network. They follow the exact same Dependency Injection rules. They do not 'own' the network; they consume the `request` fixture provided by the test engine."
        },
        {
          "objective": "api_controller",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "The backend team changes the API route from `/api/v1/customers` to `/api/v2/clients`.",
          "q": "If you used the API Controller pattern, how many files do you need to modify to fix the 200 tests that seed customer data?",
          "options": [
            "200 test files.",
            "Exactly ONE file. You update the URL string inside the `CustomerAPI` controller class. All 200 tests automatically inherit the change without any modification.",
            "You must rewrite the framework.",
            "You must use a regex."
          ],
          "a": "Exactly ONE file. You update the URL string inside the `CustomerAPI` controller class. All 200 tests automatically inherit the change without any modification.",
          "explanation": "This is the essence of Abstraction and the DRY (Don't Repeat Yourself) principle. Controllers create a single source of truth for the network topology, drastically reducing maintenance overhead."
        },
        {
          "objective": "api_controller",
          "type": "multi-select",
          "difficulty": "easy",
          "scenario": "You are designing the return type for an `api.getOrder(id)` controller method.",
          "q": "Why is returning the raw `response` object generally considered an anti-pattern? (Select all that apply)",
          "options": [
            "It forces the test file to manually parse the JSON (`await response.json()`), duplicating boilerplate code.",
            "The Controller should parse the JSON internally and return a strongly-typed TypeScript Interface (e.g., `Promise<Order>`), providing instant intellisense and compile-time safety to the test file.",
            "Responses cannot be returned.",
            "Responses crash the browser."
          ],
          "a": [
            "It forces the test file to manually parse the JSON (`await response.json()`), duplicating boilerplate code.",
            "The Controller should parse the JSON internally and return a strongly-typed TypeScript Interface (e.g., `Promise<Order>`), providing instant intellisense and compile-time safety to the test file."
          ],
          "explanation": "A Controller's job is to translate HTTP into Code. The test writer shouldn't have to think about 'Headers' or 'Status Codes' or 'JSON buffers'. They just want an `Order` object."
        },
        {
          "objective": "api_controller",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "Every single API request your application makes requires an `X-Correlation-ID` header for logging.",
          "q": "Where is the best architectural location to implement this requirement?",
          "options": [
            "Inside every single test file.",
            "Inside a Base API Controller class that all other Controllers inherit from, or centrally injected via the global `playwright.config.ts` (`extraHTTPHeaders`). This ensures no developer ever forgets to add it.",
            "In the UI.",
            "In a text file."
          ],
          "a": "Inside a Base API Controller class that all other Controllers inherit from, or centrally injected via the global `playwright.config.ts` (`extraHTTPHeaders`). This ensures no developer ever forgets to add it.",
          "explanation": "Cross-Cutting Concerns (like global headers, tracing IDs, or authentication tokens) must be centralized. If you force developers to remember to add a header 500 times, they will forget 50 times."
        }
      ],
      "Medium": [
        {
          "objective": "api_controller",
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "async getDocument(id: string) {\n  const res = await this.request.get(`/docs/${id}`);\n  if (!res.ok()) throw new Error(`API Failed: ${res.status()} - ${await res.text()}`);\n  return res.json();\n}",
          "q": "Why is this aggressive internal error handling inside the Controller architecturally necessary for Hybrid UI tests?",
          "options": [
