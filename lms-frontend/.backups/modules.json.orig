  {
    "id": "203-failure-academy",
    "title": "Module G: The Failure Academy",
    "group": "💎 ELITE TIER: ENGINEERING",
    "isPro": true,
    "meta": {
      "time": "120 mins",
      "type": "Code",
      "outcome": "Solve Environment Drift, Race Conditions, Browser Layout Bugs, and Data Pollution."
    },
    "slug": "203-failure-academy",
    "url": "courses/playwright/203-failure-academy",
    "tasks": [
      {
        "id": "failure_academy_suite",
        "title": "Failure Academy Test Suite",
        "hint": "Analyze the elite-test-bed route and implement tests that overcome the intentionally inserted flaws.",
        "rules": []
      }
    ],
    "quizPool": {
      "Easy": [
        {
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "Your test fails with a `strict mode violation` error on `page.locator('.submit-btn').click()`.",
          "q": "What does this error fundamentally mean?",
          "options": [
            "Playwright found more than one element matching the selector, so it refused to click because it doesn't know which one you meant",
            "The element is hidden and cannot be clicked",
            "The selector is invalid CSS",
            "The page has not finished loading"
          ],
          "a": "Playwright found more than one element matching the selector, so it refused to click because it doesn't know which one you meant",
          "explanation": "Strict mode ensures test integrity. If a locator resolves to multiple nodes, Playwright throws an error rather than silently clicking the wrong one."
        },
        {
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "await page.locator('button').nth(3).click();",
          "q": "Why is resolving strict mode errors by using `.nth()` considered a code smell?",
          "options": [
            "Because if a developer adds a new button earlier in the DOM, the index shifts and the test breaks. It is highly brittle.",
            "Because nth() is deprecated",
            "Because nth() only works on arrays",
            "Because it is too slow"
          ],
          "a": "Because if a developer adds a new button earlier in the DOM, the index shifts and the test breaks. It is highly brittle.",
          "explanation": "Index-based location assumes the DOM structure never changes. Using text or ARIA roles is significantly more resilient."
        }
      ],
      "Medium": [
        {
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "Your test fails with `Element is intercepted by another element`.",
          "q": "What is the physical reality happening in the browser?",
          "options": [
            "Playwright attempted to click the target, but an overlay, sticky header, or modal was covering the exact coordinates",
            "The element has pointer-events: none",
            "The element was deleted from the DOM just before the click",
            "The element is outside the viewport"
          ],
          "a": "Playwright attempted to click the target, but an overlay, sticky header, or modal was covering the exact coordinates",
          "explanation": "Playwright calculates the X/Y coordinates of the element's center. If it determines that another element (like a spinner or modal) is physically layered on top, it throws an interception error."
        },
        {
          "type": "multi-select",
          "difficulty": "medium",
          "scenario": "You are dealing with an incredibly flaky third-party animation that causes interception errors.",
          "q": "Which strategies can you use to safely bypass this issue? (Select all that apply)",
          "options": [
            "Use `click({ force: true })` to bypass the actionability checks and dispatch the event directly to the element",
            "Use a web-first assertion to wait for the overlay to be hidden before clicking",
            "Use `page.waitForTimeout(5000)`",
            "Use `page.evaluate` to trigger the click via JavaScript"
          ],
          "a": [
            "Use `click({ force: true })` to bypass the actionability checks and dispatch the event directly to the element",
            "Use a web-first assertion to wait for the overlay to be hidden before clicking",
            "Use `page.evaluate` to trigger the click via JavaScript"
          ],
          "explanation": "Forcing the click or using JS bypasses the visual check. The *best* approach is waiting for the overlay to disappear. Hardcoding timeouts is an anti-pattern."
        }
      ],
      "Hard": [
        {
          "type": "scenario",
          "difficulty": "hard",
          "scenario": "A test randomly fails with a `TargetClosedError` or `Session closed` exception during navigation.",
          "q": "What architectural issue most commonly triggers this class of fatal error?",
          "options": [
            "The test did not await a Promise correctly, causing the test block to finish and close the browser while an asynchronous operation was still running in the background",
            "The internet connection dropped",
            "The locator was wrong",
            "The assertion failed"
          ],
          "a": "The test did not await a Promise correctly, causing the test block to finish and close the browser while an asynchronous operation was still running in the background",
          "explanation": "Floating promises cause extreme havoc. The runner thinks the test is done, tears down the context, and then the orphaned promise attempts to execute against a destroyed page."
        }
      ]
    },
