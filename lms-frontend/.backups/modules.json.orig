    "objectives": [
      {
        "id": "01c_writing_assertions_obj",
        "title": "Complete 1.3: Writing Assertions"
      }
    ],
    "tasks": [
      {
        "title": "Sandbox: Interactive Challenge",
        "hint": "Complete the code implementation",
        "rules": [
          {
            "type": "ast_import",
            "value": "@playwright/test",
            "required": true
          },
          {
            "type": "ast_callee",
            "value": "expect",
            "required": true,
            "min": 1
          },
          {
            "type": "ast_callee",
            "value": "toBeVisible",
            "required": true,
            "min": 1
          },
          {
            "type": "ast_forbidden_callee",
            "value": "page.waitForTimeout"
          }
        ]
      }
    ],
    "quizMapping": [],
    "quizPool": {
      "Easy": [
        {
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "await expect(page.locator('.alert')).toBeVisible();",
          "q": "What does this specific assertion natively do if the alert is not immediately visible?",
          "options": [
            "It automatically retries for a default timeout (usually 5 seconds) waiting for it to appear",
            "It fails the test instantly",
            "It throws a warning but continues execution",
            "It pauses the test forever"
          ],
          "a": "It automatically retries for a default timeout (usually 5 seconds) waiting for it to appear",
          "explanation": "Playwright's `expect` matchers connected to locators (like `toBeVisible`) are auto-retrying, making them resilient to minor network/rendering delays."
        },
        {
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You need to verify that a greeting element contains the text 'Welcome'.",
          "q": "Which assertion correctly implements a partial text match?",
          "options": [
            "await expect(locator).toContainText('Welcome');",
            "await expect(locator).toHaveText('Welcome');",
            "await expect(locator).toBe('Welcome');",
            "await expect(locator).toHaveValue('Welcome');"
          ],
          "a": "await expect(locator).toContainText('Welcome');",
          "explanation": "`toContainText` performs a substring match, whereas `toHaveText` requires an exact, full-string match by default."
        }
      ],
      "Medium": [
        {
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "You are testing an input field. After typing 'Jane', you want to assert that the input field actually reflects that state.",
          "q": "Which assertion is appropriate for validating the state of an `<input>` element?",
          "options": [
            "await expect(locator).toHaveValue('Jane');",
            "await expect(locator).toHaveText('Jane');",
            "await expect(locator).toContainText('Jane');",
            "await expect(locator).toBeChecked();"
          ],
          "a": "await expect(locator).toHaveValue('Jane');",
          "explanation": "Input fields store their content in the `value` property, not in the innerText/textContent DOM nodes, so `toHaveValue` must be used."
        },
        {
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "expect(await page.locator('.title').textContent()).toBe('Dashboard');",
          "q": "Why is this considered a brittle anti-pattern compared to web-first assertions?",
          "options": [
            "It extracts the text string first and runs a static assertion, completely losing the auto-retrying capability",
            "It requires too much RAM",
            "textContent() always returns null in Playwright",
            "It throws a syntax error"
          ],
          "a": "It extracts the text string first and runs a static assertion, completely losing the auto-retrying capability",
          "explanation": "By fetching the text manually, the check happens instantly. If the UI hasn't fully rendered the text in that exact millisecond, it fails. Web-first assertions evaluate *inside* the retry loop."
        }
      ],
      "Hard": [
        {
          "type": "scenario",
          "difficulty": "hard",
          "scenario": "You need to verify that a dynamically generating success message explicitly ends with 'has been saved'.",
          "q": "How can you enforce this strict pattern match using Playwright assertions?",
          "options": [
            "Pass a Regular Expression to the assertion: await expect(locator).toHaveText(/has been saved$/);",
            "Use a wildcard string: await expect(locator).toHaveText('*has been saved');",
            "You must use a Custom Matcher plugin",
            "Loop through the text until it matches"
          ],
          "a": "Pass a Regular Expression to the assertion: await expect(locator).toHaveText(/has been saved$/);",
          "explanation": "Playwright assertions fully support JavaScript Regular Expressions, allowing you to build highly complex pattern-matching logic (like `$` for end-of-string)."
        }
      ]
    },
    "icon": "🚀",
    "slug": "12-writing-assertions",
    "learningPaths": [
      "foundations",
      "enterprise"
    ],
    "category": "core",
    "optional": false,
    "industryTags": [],
    "estimatedMinutes": 45,
    "certificateTrack": "Playwright Foundations"
  },
