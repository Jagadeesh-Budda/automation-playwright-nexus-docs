  {
    "id": "43-fundamentals-debug",
    "title": "8.4: Conflict Resolution",
    "url": "courses/playwright/43-fundamentals-debug",
    "group": "🧱 MODULE 8: ENTERPRISE PRACTICES",
    "level": 6,
    "weight": 15,
    "meta": {
      "time": "20 mins",
      "type": "Debug",
      "outcome": "Handle common Git and dependency conflicts"
    },
    "objectives": [
      {
        "id": "debug_env",
        "title": "Resolve environment synchronization issues"
      }
    ],
    "tasks": [
      {
        "id": "fix_conflict",
        "title": "Rebase Simulation",
        "hint": "Run 'git rebase main'",
        "rules": [
          {
            "type": "contains",
            "value": "rebase"
          },
          {
            "type": "ast_forbidden_callee",
            "value": "page.waitForTimeout"
          }
        ]
      }
    ],
    "quizMapping": [
      {
        "objective": "debug_env",
        "weight": 100
      }
    ],
    "spec": {
      "git": "Rebase",
      "resolution": "Manual Fix"
    },
    "quizPool": {
      "Easy": [
        {
          "objective": "debug_env",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You run `npm install` and receive a massive wall of red text complaining about 'ERESOLVE unable to resolve dependency tree' and 'peer dependencies'.",
          "q": "What is the industry-standard initial command to bypass strict peer dependency conflicts in legacy projects?",
          "options": [
            "npm install --legacy-peer-deps",
            "npm install --force",
            "npm audit fix --force",
            "rm package-lock.json && npm install"
          ],
          "a": "npm install --legacy-peer-deps",
          "explanation": "NPM v7+ introduced strict peer dependency resolution, which often breaks legacy projects. Using `--legacy-peer-deps` tells NPM to ignore peer dependency conflicts and install anyway. Using `--force` is dangerous as it fetches different versions and breaks the lockfile."
        },
        {
          "objective": "debug_env",
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "git checkout feature-login\ngit rebase main\n# CONFLICT (content): Merge conflict in tests/login.spec.ts",
          "q": "You are rebasing your branch onto main, but encounter a merge conflict. After opening the file, resolving the `<<<<<<<` and `>>>>>>>` markers, what are the exact next two commands you must run?",
          "options": [
            "git add tests/login.spec.ts  followed by  git rebase --continue",
            "git commit -m 'resolved'  followed by  git push",
            "git rebase --skip  followed by  git merge",
            "git add tests/login.spec.ts  followed by  git commit"
          ],
          "a": "git add tests/login.spec.ts  followed by  git rebase --continue",
          "explanation": "During a rebase, you never create a 'merge commit' to resolve conflicts. You simply stage the resolved file using `git add`, and then tell git to proceed with the rebase using `git rebase --continue`."
        },
        {
          "objective": "debug_env",
          "type": "multi-select",
          "difficulty": "easy",
          "scenario": "A colleague is confused about the difference between merging and rebasing when updating their feature branch with the latest changes from `main`.",
          "q": "Which of the following statements accurately describe `git rebase`? (Select all that apply)",
          "options": [
            "It rewrites the commit history of your feature branch.",
            "It places your feature commits directly on top of the latest main commits.",
            "It creates a dedicated 'Merge pull request' commit.",
            "It prevents the creation of a linear project history.",
            "It changes the cryptographic hashes (SHAs) of your existing commits."
          ],
          "a": [
            "It rewrites the commit history of your feature branch.",
            "It places your feature commits directly on top of the latest main commits.",
            "It changes the cryptographic hashes (SHAs) of your existing commits."
          ],
          "explanation": "Rebasing lifts your local commits and replays them on top of the new base branch. Because the parent commit changes, the cryptographic hash of every commit changes, rewriting history. It *creates* a linear history by avoiding merge commits."
        },
        {
          "objective": "debug_env",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You have successfully rebased your local branch. You try to push it to your remote repository, but Git rejects it, stating: `Updates were rejected because the tip of your current branch is behind its remote counterpart.`",
          "q": "What command must you use to successfully push your rebased branch?",
          "options": [
            "git push --force-with-lease",
            "git pull origin branch-name",
            "git merge main",
            "git push --rebase"
          ],
          "a": "git push --force-with-lease",
          "explanation": "Because a rebase rewrites local commit history, your local branch no longer matches the remote branch history. A standard `git push` fails. You must force the push. `--force-with-lease` is safer than `--force` because it verifies nobody else has pushed commits to the remote branch in the meantime."
        },
        {
          "objective": "debug_env",
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "test('flaky login', async ({ page }) => {\n  await page.click('#login');\n  await page.waitForTimeout(5000);\n  await page.click('#submit');\n});",
          "q": "During a code review, an architect rejects this code because of a flaky behavior pattern. Why?",
          "options": [
            "Hardcoded timeouts (waitForTimeout) create race conditions; if the app takes 5.1 seconds to load, the test fails, and if it takes 1 second, you waste 4 seconds.",
            "The '#login' locator is invalid syntax.",
            "Playwright does not support the 'waitForTimeout' method.",
            "The test lacks a try/catch block."
          ],
          "a": "Hardcoded timeouts (waitForTimeout) create race conditions; if the app takes 5.1 seconds to load, the test fails, and if it takes 1 second, you waste 4 seconds.",
          "explanation": "Hardcoded sleeps (`waitForTimeout`) are the #1 cause of flaky tests in UI automation. They never adapt to dynamic network speeds. Tests should use auto-waiting locators or `expect(locator).toBeVisible()` to dynamically proceed as soon as the element is ready."
        }
      ],
      "Medium": [
        {
          "objective": "debug_env",
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "You are deep in the middle of a complex rebase. You realize you have messed up the conflict resolutions and the files are completely broken.",
          "q": "What command instantly aborts the rebase and returns your repository to the exact state it was in before you started?",
          "options": [
            "git rebase --abort",
            "git reset --hard HEAD",
            "git checkout -- .",
            "git clean -fd"
          ],
          "a": "git rebase --abort",
          "explanation": "Git tracks the state of the branch before the rebase started. Running `git rebase --abort` safely cancels the operation, removes all temporary rebase files, and restores your branch to its original state."
        },
        {
          "objective": "debug_env",
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "git fetch origin\ngit rebase origin/main\n# CONFLICT (content): Merge conflict in package.json\n# CONFLICT (content): Merge conflict in package-lock.json",
          "q": "When dealing with dependency conflicts, a developer manually resolves `package.json`, then manually opens `package-lock.json` to fix the hundreds of conflict markers inside it. Why is this an architectural anti-pattern?",
          "options": [
            "The lockfile is machine-generated; you should never resolve it manually. Instead, resolve package.json, delete the lockfile, and run npm install to regenerate it.",
            "The lockfile should be added to .gitignore so it never conflicts.",
            "The developer should use `npm audit fix` to resolve lockfile conflicts.",
            "The developer should use `--ours` for the lockfile unconditionally."
          ],
          "a": "The lockfile is machine-generated; you should never resolve it manually. Instead, resolve package.json, delete the lockfile, and run npm install to regenerate it.",
          "explanation": "`package-lock.json` is a massive, machine-generated tree. Manually resolving git conflict markers inside it usually corrupts the JSON structure. The standard workflow is to resolve `package.json`, run `npm install` to let NPM rebuild the lockfile properly, and stage both files."
        },
        {
          "objective": "debug_env",
          "type": "multi-select",
          "difficulty": "medium",
          "scenario": "Your tests randomly fail on CI with a 'Target closed' error during a `page.click()` operation. The failure rate is about 5%.",
          "q": "Which of the following are valid root causes for this specific Playwright error? (Select all that apply)",
          "options": [
            "A race condition where an earlier click triggered a page navigation, and Playwright attempted the next action while the DOM was actively destroying itself.",
            "The application crashed or threw an unhandled exception, causing the browser tab to close.",
            "The locator used for the click is incorrect and points to a non-existent element.",
            "A background script deliberately called `window.close()` on the tab.",
            "The Playwright version is too old to support the click method."
          ],
          "a": [
            "A race condition where an earlier click triggered a page navigation, and Playwright attempted the next action while the DOM was actively destroying itself.",
            "The application crashed or threw an unhandled exception, causing the browser tab to close.",
            "A background script deliberately called `window.close()` on the tab."
          ],
          "explanation": "'Target closed' strictly means the browser tab/context disappeared while Playwright was trying to communicate with it. It does *not* mean a locator was wrong (that throws a TimeoutError). It usually indicates race conditions around navigation, or the app crashing the tab."
        },
        {
          "objective": "debug_env",
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "During a PR review, you notice a developer committed the `node_modules` folder to the repository. The repo size has ballooned by 500MB, and pipelines are failing.",
          "q": "What is the correct sequence of Git commands to permanently remove the folder from Git tracking without deleting it from the developer's local hard drive?",
          "options": [
            "git rm -r --cached node_modules && git commit",
            "rm -rf node_modules && git commit",
            "git restore node_modules && git commit",
            "git reset HEAD node_modules && git commit"
          ],
          "a": "git rm -r --cached node_modules && git commit",
          "explanation": "The `git rm --cached` command removes the file/folder from Git's tracking index but leaves the physical files untouched on your local disk. Simply adding it to `.gitignore` afterward ensures it won't be re-tracked."
        },
        {
          "objective": "debug_env",
          "type": "multi-select",
          "difficulty": "medium",
          "scenario": "Your local branch is deeply corrupted after several bad rebases and force-pushes. You want to discard everything on your local machine and force your local branch to match the remote server exactly.",
          "q": "Which commands must you run sequentially to achieve this hard reset? (Select all that apply)",
          "options": [
            "git fetch origin",
            "git reset --hard origin/<branch-name>",
            "git pull origin <branch-name>",
            "git rebase --abort",
            "git push --force"
          ],
          "a": [
            "git fetch origin",
            "git reset --hard origin/<branch-name>"
          ],
          "explanation": "To mirror the remote exactly, you first `git fetch origin` to download the latest state of the remote repository without merging. Then, `git reset --hard origin/<branch-name>` forces your local working directory and commit history to perfectly match the remote."
        }
      ],
      "Hard": [
        {
          "objective": "debug_env",
          "type": "code-analysis",
          "difficulty": "hard",
          "code": "test('intercept API', async ({ page }) => {\n  let responseData;\n  page.on('response', async res => {\n    if (res.url().includes('/api/user')) {\n      responseData = await res.json();\n    }\n  });\n  await page.click('#submit');\n  expect(responseData.id).toBe(123);\n});",
          "q": "This test passes occasionally but usually throws a `TypeError: Cannot read properties of undefined (reading 'id')`. What is the architectural flaw causing this race condition?",
          "options": [
            "The test does not await the response event. It clicks submit and immediately evaluates the expect assertion before the async network callback finishes.",
            "page.on() is deprecated in favor of page.route().",
            "The response object cannot be parsed as JSON inside an event listener.",
            "The locator #submit is incorrect."
          ],
          "a": "The test does not await the response event. It clicks submit and immediately evaluates the expect assertion before the async network callback finishes.",
          "explanation": "Event listeners (`page.on`) run asynchronously in the background. The script executes the click and instantly runs the assertion before the network response arrives. The correct pattern is to use `const responsePromise = page.waitForResponse('**/api/user'); await page.click('#submit'); const res = await responsePromise;`."
        },
        {
          "objective": "debug_env",
          "type": "scenario",
          "difficulty": "hard",
          "scenario": "A junior developer force-pushed to the `main` branch, overwriting a week's worth of commits from the rest of the team. The branch is completely broken.",
          "q": "As the lead architect, what advanced Git feature allows you to recover the lost commits, even though they were overwritten on the remote?",
          "options": [
            "git reflog",
            "git fsck",
            "git bisect",
            "git cherry-pick"
          ],
          "a": "git reflog",
          "explanation": "Git keeps a local, chronological log of every time the HEAD pointer moves, regardless of branches or force pushes, called the `reflog`. You can inspect the `reflog`, find the hash of the commit just before the catastrophic force push, and reset the branch back to that hash."
        },
        {
          "objective": "debug_env",
          "type": "multi-select",
          "difficulty": "hard",
          "scenario": "You are writing a pipeline script. Your tests must run against a dynamic preview URL generated by Vercel. However, the preview URL takes about 2-3 minutes to become ready after the deployment step finishes.",
          "q": "What are the most stable, enterprise-grade ways to handle this environment synchronization issue in CI/CD? (Select all that apply)",
          "options": [
            "Use a bash script to poll the preview URL with `curl` until it returns a 200 HTTP status before running the Playwright step.",
            "Use the `wait-on` npm package to block execution until the URL responds with a 200 OK.",
            "Add `page.waitForTimeout(180000)` to the global setup file in Playwright.",
            "Add a `sleep 180` command directly in the GitHub Actions YAML.",
            "Configure Playwright's `baseURL` to retry automatically."
          ],
          "a": [
            "Use a bash script to poll the preview URL with `curl` until it returns a 200 HTTP status before running the Playwright step.",
            "Use the `wait-on` npm package to block execution until the URL responds with a 200 OK."
          ],
          "explanation": "Waiting for an environment to boot requires dynamic polling at the infrastructure level. Polling via `curl` or using a dedicated package like `wait-on` ensures the pipeline proceeds the exact second the URL is ready. Hardcoded sleeps (`sleep 180`) are inefficient and fragile."
        },
        {
          "objective": "debug_env",
          "type": "code-analysis",
          "difficulty": "hard",
          "code": "test('verify file download', async ({ page }) => {\n  const [download] = await Promise.all([\n    page.waitForEvent('download'),\n    page.click('#download-btn')\n  ]);\n  const path = await download.path();\n  const fs = require('fs');\n  const content = fs.readFileSync(path, 'utf8');\n  expect(content).toContain('Invoice');\n});",
          "q": "This test passes locally, but fails in CI/CD with an error `ENOENT: no such file or directory, open '/tmp/playwright-artifacts/.../download'`. What is the architectural reason for this failure?",
          "options": [
            "The file is being read before the download has fully completed downloading to the disk.",
            "CI environments do not have file system access.",
            "The `Promise.all` pattern is invalid for downloads.",
            "The `download.path()` method returns a URL, not a file path."
          ],
          "a": "The file is being read before the download has fully completed downloading to the disk.",
          "explanation": "In Playwright, `download.path()` returns a temporary path, but there's a notorious race condition: the file might still be streaming to disk when you try to read it. The enterprise solution is to explicitly save it using `await download.saveAs('custom/path.csv')` and read from that permanent location."
        },
        {
          "objective": "debug_env",
          "type": "scenario",
          "difficulty": "hard",
          "scenario": "Your team uses `git bisect` to find exactly which commit introduced a flaky test failure. However, out of the 50 commits being searched, several of them contain syntax errors that prevent the app from even building, causing the bisect process to fail prematurely.",
          "q": "How do you instruct `git bisect` to handle a commit that cannot be built or tested?",
          "options": [
            "git bisect skip",
            "git bisect ignore",
            "git bisect bad",
            "git bisect abort"
          ],
          "a": "git bisect skip",
          "explanation": "During a bisect, if a commit is untestable (e.g., won't compile), you run `git bisect skip`. Git will ignore that commit and automatically check out a nearby commit to continue the binary search process."
        }
      ]
    },
