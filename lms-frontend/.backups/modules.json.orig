          "code": "FROM mcr.microsoft.com/playwright:v1.40.0-jammy\nWORKDIR /app\nCOPY package*.json ./\nRUN npm ci\nCOPY . .\nCMD [\"npx\", \"playwright\", \"test\"]",
          "q": "You are building a Docker image to run your tests in AWS Fargate. You notice that the build process is extremely slow because it reinstalls all NPM packages every time you change a single line of test code. Why is this happening?",
          "options": [
            "Because `COPY . .` copies the entire directory, invalidating the Docker cache for the `RUN npm ci` layer whenever any file changes.",
