  {
    "id": "29-what-are-fixtures",
    "title": "5.1: What Are Fixtures?",
    "url": "courses/playwright/29-what-are-fixtures",
    "group": "🧩 MODULE 5: FIXTURES & DI",
    "level": 5,
    "weight": 5,
    "meta": {
      "time": "20 mins",
      "type": "Code",
      "outcome": "Understand dependency injection."
    },
    "objectives": [
      {
        "id": "05b_what_are_fixtures_obj",
        "title": "Complete 5.1: What Are Fixtures?"
      }
    ],
    "tasks": [],
    "quizMapping": [
      {
        "objective": "05b_what_are_fixtures_obj",
        "weight": 100
      }
    ],
    "quizPool": {
      "Easy": [
        {
          "type": "mcq",
          "difficulty": "easy",
          "q": "Why are Playwright fixtures generally preferred over standard beforeEach hooks?",
          "options": [
            "Fixtures establish strong isolation and explicit dependency injection per test",
            "Fixtures are exactly the same as beforeEach hooks",
            "Fixtures run asynchronously while hooks are synchronous",
            "Fixtures only run once per test suite"
          ],
          "a": "Fixtures establish strong isolation and explicit dependency injection per test",
          "explanation": "Fixtures provide independent, isolated environments for each test, avoiding shared state issues."
        }
      ],
      "Medium": [
        {
          "type": "code-analysis",
          "difficulty": "medium",
          "q": "What happens to the page fixture after a test block finishes executing?",
          "options": [
            "Playwright automatically tears down the isolated Browser Context and closes the page, ensuring a clean slate for the next test.",
            "The page remains open and is reused by the next test in the file.",
            "The developer must manually call await page.close() or memory leaks will occur.",
            "The entire Browser executable is killed and rebooted."
          ],
          "a": "Playwright automatically tears down the isolated Browser Context and closes the page, ensuring a clean slate for the next test.",
          "explanation": "Built-in fixtures like page are bound to the lifecycle of the test. Playwright handles the teardown automatically, guaranteeing that no cookies, local storage, or DOM state bleed into the next test."
        }
      ],
      "Hard": [
        {
          "type": "code-analysis",
          "difficulty": "hard",
          "code": "test('Purchase', async ({ browser }) => {\n  const context = await browser.newContext();\n  const page = await context.newPage();\n});",
          "q": "Why might a Senior SDET choose to manually inject the browser fixture and create their own context, instead of just using the default page fixture?",
          "options": [
            "Because they need to simulate a multi-tab or multi-user scenario (e.g., User A and User B interacting simultaneously in separate isolated sessions).",
            "Because the default page fixture does not support JavaScript.",
            "Because the browser fixture executes tests 50% faster.",
            "Because the page fixture cannot handle await page.goto()."
          ],
          "a": "Because they need to simulate a multi-tab or multi-user scenario (e.g., User A and User B interacting simultaneously in separate isolated sessions).",
          "explanation": "The default page fixture provides a single, isolated context. If you are testing a real-time chat application and need two users logged in simultaneously with different cookies, you must inject the raw browser fixture and instantiate multiple distinct contexts manually."
        }
      ]
    },
    "icon": "🧩",
    "slug": "29-what-are-fixtures",
    "learningPaths": [
      "foundations",
      "enterprise"
    ],
    "category": "core",
    "optional": false,
    "industryTags": [],
    "estimatedMinutes": 45,
    "certificateTrack": "Playwright Foundations"
  },
  {
    "id": "30-custom-fixtures",
    "title": "5.2: Creating Custom Fixtures",
    "url": "courses/playwright/30-custom-fixtures",
    "group": "🧩 MODULE 5: FIXTURES & DI",
    "level": 5,
    "weight": 5,
    "meta": {
      "time": "25 mins",
      "type": "Code",
      "outcome": "Use test.extend()."
    },
    "objectives": [
      {
        "id": "05c_custom_fixtures_obj",
        "title": "Complete 5.2: Creating Custom Fixtures"
      }
    ],
    "tasks": [
      {
        "title": "Sandbox: Interactive Challenge",
        "hint": "Complete the code implementation",
        "rules": [
          {
            "type": "ast_callee_any",
            "values": [
              "base.extend",
              "test.extend"
            ],
            "required": true,
            "min": 1
          }
        ]
      }
    ],
    "quizMapping": [],
    "quizPool": {
      "Easy": [
        {
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "const test = base.extend({\n  adminPage: async ({ page }, use) => {\n    await login(page, 'admin');\n    await use(page);\n  }\n});",
          "q": "In this custom fixture, what does the `use()` function do?",
          "options": [
            "It pauses the fixture and hands execution control over to the actual test block, passing the initialized data",
            "It deletes the page object",
            "It throws an error if the test fails",
            "It runs an assertion"
          ],
          "a": "It pauses the fixture and hands execution control over to the actual test block, passing the initialized data",
          "explanation": "The `use()` callback is the boundary between the Setup phase and the Test phase. Calling it 'yields' the execution to the test."
        },
        {
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You have created a custom fixture called `databaseConnection`. You want a specific test to utilize it.",
          "q": "How do you request this fixture in your test?",
          "options": [
            "Simply add `{ databaseConnection }` to the test function arguments",
            "Call global.databaseConnection",
            "Import it directly from the file",
            "Use the --fixture CLI flag"
          ],
          "a": "Simply add `{ databaseConnection }` to the test function arguments",
          "explanation": "Playwright uses Dependency Injection. You just destructure the name of the fixture in the argument list, and Playwright dynamically initializes it for you."
        }
      ],
      "Medium": [
        {
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "const test = base.extend({\n  logger: async ({}, use) => {\n    console.log('Setup');\n    await use();\n    console.log('Teardown');\n  }\n});",
          "q": "If the test fails, does the 'Teardown' code still execute?",
          "options": [
            "Yes. Code placed after `use()` is guaranteed to execute during the teardown phase, regardless of test pass/fail status",
            "No, the worker crashes immediately",
            "Only if you add a try/catch block",
            "Yes, but it runs before the test ends"
          ],
          "a": "Yes. Code placed after `use()` is guaranteed to execute during the teardown phase, regardless of test pass/fail status",
          "explanation": "Fixtures natively handle safe teardown. The engine ensures the block after `use()` runs so you can clean up databases or close connections safely."
        },
        {
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "You want your custom `adminPage` fixture to execute automatically for every single test in the file, even if the test doesn't explicitly request it in the arguments.",
          "q": "How can you achieve this?",
          "options": [
            "Set `auto: true` in the fixture options definition",
            "You cannot do this; fixtures must always be requested",
            "Put it in the test.describe",
            "Name the fixture 'global'"
          ],
          "a": "Set `auto: true` in the fixture options definition",
          "explanation": "You can define automatic fixtures by passing an array syntax: `adminPage: [ async ({}, use) => { ... }, { auto: true } ]`. These act like transparent beforeEach hooks."
        }
      ],
      "Hard": [
        {
          "type": "multi-select",
          "difficulty": "hard",
          "scenario": "A Senior SDET argues that Fixtures are architecturally superior to standard Page Object Models instantiated in `beforeEach` hooks.",
          "q": "What are the primary architectural benefits of Playwright Fixtures? (Select all that apply)",
          "options": [
            "Lazy loading: Fixtures only instantiate if a test specifically requests them, saving execution time",
            "Encapsulated teardown: Fixtures handle their own cleanup safely without needing a separate `afterEach` block",
            "Global State: Fixtures share the exact same variable instance across all tests in parallel",
            "Composability: Fixtures can depend on other fixtures to build complex dependency trees safely"
          ],
          "a": [
            "Lazy loading: Fixtures only instantiate if a test specifically requests them, saving execution time",
            "Encapsulated teardown: Fixtures handle their own cleanup safely without needing a separate `afterEach` block",
            "Composability: Fixtures can depend on other fixtures to build complex dependency trees safely"
          ],
          "explanation": "Fixtures are isolated per-test, they do NOT share global state (which is a good thing!). They excel in lazy evaluation, encapsulation, and tree-like composability."
        }
      ]
    },
    "icon": "🧩",
    "slug": "30-custom-fixtures",
