    "quizPool": {
      "Easy": [
        {
          "objective": "api_request",
          "type": "mcq",
          "difficulty": "easy",
          "q": "Which built-in Playwright fixture is exclusively designed for making direct HTTP/REST API calls without using a browser?",
          "options": [
            "page",
            "context",
            "request",
            "browser"
          ],
          "a": "request",
          "explanation": "The `request` fixture provides a highly optimized `APIRequestContext`. It acts as an incredibly fast, headless HTTP client (like curl or Postman) perfectly integrated into the Playwright assertion engine."
        },
        {
          "objective": "api_request",
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "test('Get User API', async ({ request }) => {\n  const response = await request.get('/api/users/1');\n  expect(response.status()).toBe(200);\n});",
          "q": "If the `playwright.config.ts` defines `baseURL: 'https://staging.myapp.com'`, what exact URL does this test actually hit?",
          "options": [
            "http://localhost:3000/api/users/1",
            "https://staging.myapp.com/api/users/1",
            "/api/users/1",
            "It fails because the URL is relative."
          ],
          "a": "https://staging.myapp.com/api/users/1",
          "explanation": "Just like the `page.goto()` method, the `request` fixture automatically inherits the `baseURL` from the configuration. This makes transitioning API tests between Dev, Staging, and Production completely seamless."
        },
        {
          "objective": "api_request",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You need to create a new user via API before a UI test begins.",
          "q": "What HTTP method should you use on the `request` fixture to send the creation data to the server?",
          "options": [
            "request.get('/api/users')",
            "request.post('/api/users', { data: { name: 'Alice' } })",
            "request.put('/api/users')",
            "request.delete('/api/users')"
          ],
          "a": "request.post('/api/users', { data: { name: 'Alice' } })",
          "explanation": "Standard REST conventions dictate that POST is used to create new resources. Playwright elegantly handles the serialization of the `data` object into a JSON payload and automatically sets the `Content-Type: application/json` header."
        },
        {
          "objective": "api_request",
          "type": "multi-select",
          "difficulty": "easy",
          "scenario": "You want to verify that an API response contains the expected data.",
          "q": "Which of the following Playwright commands correctly extract data from the HTTP `response` object? (Select all that apply)",
          "options": [
            "const json = await response.json(); // Parses the body as a JSON object.",
            "const text = await response.text(); // Returns the raw body as a string.",
            "const buffer = await response.body(); // Returns a raw Node.js Buffer (for files/images).",
            "const css = await response.css();"
          ],
          "a": [
            "const json = await response.json(); // Parses the body as a JSON object.",
            "const text = await response.text(); // Returns the raw body as a string.",
            "const buffer = await response.body(); // Returns a raw Node.js Buffer (for files/images)."
          ],
          "explanation": "The `response` object provides multiple asynchronous methods to parse the underlying HTTP packet depending on the content type (JSON for APIs, Text for HTML/Logs, Buffer for PDF/Image downloads)."
        },
        {
          "objective": "api_request",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "An API test fails randomly. You want to see the exact JSON payload the server returned to debug the error.",
          "q": "What is the simplest way to dump the API response body to the terminal for debugging?",
          "options": [
            "console.log(response);",
            "console.log(await response.json());",
            "expect(response).toBeVisible();",
            "Use the trace viewer."
          ],
          "a": "console.log(await response.json());",
          "explanation": "Because `response.json()` is an asynchronous Promise that reads the network stream, you MUST `await` it before logging. Logging the raw `response` object will just print useless internal Playwright wrapper class metadata."
        }
      ],
      "Medium": [
        {
          "objective": "api_request",
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "test('Safe API Call', async ({ request }) => {\n  const response = await request.post('/api/flaky', { data: { id: 1 } });\n  expect(response.ok()).toBeTruthy();\n});",
          "q": "What exact range of HTTP status codes does the `response.ok()` method evaluate to `true`?",
          "options": [
            "Only exactly 200.",
            "Any status code in the 200-299 range (e.g., 200 OK, 201 Created, 204 No Content).",
            "Anything under 400.",
            "Anything except 500."
          ],
          "a": "Any status code in the 200-299 range (e.g., 200 OK, 201 Created, 204 No Content).",
          "explanation": "REST APIs use a spectrum of success codes. `response.ok()` is a brilliant utility that instantly validates if the server considered the transaction successful, without forcing you to hardcode `toBe(201)` vs `toBe(200)`."
        },
        {
          "objective": "api_request",
          "type": "multi-select",
