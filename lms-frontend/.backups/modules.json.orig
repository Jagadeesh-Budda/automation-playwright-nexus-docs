  {
    "id": "07-js-ts-lite",
    "title": "0.7: TypeScript Lite",
    "url": "courses/playwright/07-js-ts-lite",
    "group": "🌱 MODULE 0: JS/TS FOR AUTOMATION",
    "level": 0,
    "weight": 5,
    "meta": {
      "time": "15 mins",
      "type": "Code",
      "outcome": "Recognize interfaces, types, and classes."
    },
    "objectives": [
      {
        "id": "00f3_js_ts_lite_obj",
        "title": "Complete 0.7: TypeScript Lite"
      }
    ],
    "tasks": [
      {
        "title": "Sandbox: Find the TypeScript Bug",
        "hint": "Fix the compile error by passing the correct types"
      }
    ],
    "quizMapping": [],
    "quizPool": {
      "Easy": [
        {
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You are writing a TypeScript test. You define a variable: `let count = 5;`",
          "q": "If you try to write `count = 'ten';` on the next line, what happens?",
          "options": [
            "TypeScript throws a compiler error because 'count' was implicitly typed as a number",
            "It successfully changes the type to a string",
            "Playwright crashes at runtime",
            "The variable becomes undefined"
          ],
          "a": "TypeScript throws a compiler error because 'count' was implicitly typed as a number",
          "explanation": "TypeScript uses Type Inference. Since you assigned an integer initially, it locked the variable type to `number`."
        },
        {
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "function greet(name: string) {\n  return `Hello, ${name}`;\n}",
          "q": "What does the `: string` syntax achieve?",
          "options": [
            "It guarantees that anyone calling this function must pass a string argument, catching bugs before the code runs",
            "It casts whatever is passed into a string",
            "It is just a comment for the developer",
            "It makes the function run synchronously"
          ],
          "a": "It guarantees that anyone calling this function must pass a string argument, catching bugs before the code runs",
          "explanation": "Type annotations act as a strict contract, allowing the TypeScript compiler to reject invalid inputs during development."
        }
      ],
      "Medium": [
        {
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "You are building a fixture that passes test data to your test blocks. The data object must contain an email, but the phone number is optional.",
          "q": "How do you define an optional property in a TypeScript Interface?",
          "options": [
            "phone?: string",
            "phone: string | null",
            "phone!: string",
            "optional phone: string"
          ],
          "a": "phone?: string",
          "explanation": "The `?` operator marks a property as optional, meaning the object is perfectly valid whether the property exists or is omitted entirely."
        },
        {
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "interface UserResponse {\n  id: number;\n  status: 'active' | 'banned';\n}",
          "q": "What is the technical term for the `'active' | 'banned'` syntax?",
          "options": [
            "String Literal Union Type",
            "Enum",
            "Tuple",
            "Any Array"
          ],
          "a": "String Literal Union Type",
          "explanation": "This restricts the string to strictly exact allowed values, providing powerful autocomplete and catching typos instantly."
        }
      ],
      "Hard": [
        {
          "type": "scenario",
          "difficulty": "hard",
          "scenario": "You are mocking an API response using `page.route()`. You want to type-cast the raw JSON response object to your strict `OrderPayload` interface so you get autocomplete.",
          "q": "Which syntax allows you to explicitly tell the TypeScript compiler the type of an untyped variable?",
          "options": [
            "const data = json as OrderPayload;",
            "const data = typeof OrderPayload(json);",
            "const data = convert<OrderPayload>(json);",
            "const data: OrderPayload;"
          ],
          "a": "const data = json as OrderPayload;",
          "explanation": "The `as` keyword performs Type Assertion, telling the compiler 'trust me, I know this raw JSON fits this interface shape'."
        }
      ]
    },
