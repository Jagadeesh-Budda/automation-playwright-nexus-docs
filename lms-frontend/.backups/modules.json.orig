  {
    "id": "49-browser-network-mechanics",
    "title": "8.10: Browser Engine & Network Mechanics",
    "group": "🧱 MODULE 8: ENTERPRISE PRACTICES",
    "icon": "🌐",
    "quizPool": {
      "Easy": [
        {
          "objective": "browser_network_mechanics",
          "type": "mcq",
          "difficulty": "easy",
          "q": "Which of the following browser engines does Playwright natively support and bundle by default?",
          "options": [
            "Chromium, Firefox, WebKit",
            "Chrome, Safari, Edge",
            "Chromium, Gecko, Trident",
            "Chrome, Firefox, Internet Explorer"
          ],
          "a": "Chromium, Firefox, WebKit",
          "explanation": "Playwright downloads and bundles the core rendering engines (Chromium, Firefox, and WebKit) rather than the branded browsers (Chrome, Safari). This ensures perfectly hermetic, deterministic execution across different operating systems."
        },
        {
          "objective": "browser_network_mechanics",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You are testing an image-heavy e-commerce site. To speed up execution and reduce bandwidth on the CI server, you want the browser to simply not download any images.",
          "q": "Which Playwright capability easily allows you to achieve this?",
          "options": [
            "page.route('**/*.{png,jpg,jpeg}', route => route.abort());",
            "page.setViewportSize({ width: 0, height: 0 })",
            "page.evaluate(() => document.querySelectorAll('img').forEach(img => img.remove()))",
            "browserContext.disableImages()"
          ],
          "a": "page.route('**/*.{png,jpg,jpeg}', route => route.abort());",
          "explanation": "Playwright's `page.route()` intercepts network traffic *before* it leaves the browser. By calling `route.abort()` on image patterns, the browser instantly rejects the request, saving massive amounts of time and bandwidth."
        },
        {
          "objective": "browser_network_mechanics",
          "type": "multi-select",
          "difficulty": "easy",
          "scenario": "Your frontend team is building a new UI, but the backend API is not finished yet.",
          "q": "Why would an SDET utilize Network Mocking (Intercepting and Fulfilling) in this scenario? (Select all that apply)",
          "options": [
            "To force the UI to render 'Success' and 'Error' states by artificially injecting 200 or 500 HTTP status codes.",
            "To allow the frontend tests to run completely isolated from backend downtime.",
            "To test the actual backend database performance.",
            "To fix bugs in the backend code."
          ],
          "a": [
            "To force the UI to render 'Success' and 'Error' states by artificially injecting 200 or 500 HTTP status codes.",
            "To allow the frontend tests to run completely isolated from backend downtime."
          ],
          "explanation": "Mocking intercepts the frontend's outgoing request and fulfills it instantly with fake data/statuses. This allows you to test the UI's resilience (how does it handle a 500 error?) without touching the actual backend."
        },
        {
          "objective": "browser_network_mechanics",
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "await page.route('**/api/v1/users', async route => {\n  const json = [{ id: 1, name: 'Alice' }];\n  await route.fulfill({ json });\n});",
          "q": "What happens when the application executes a `fetch('/api/v1/users')` in the browser?",
          "options": [
            "The browser sends the request to the real server, then replaces the response with the fake JSON.",
            "The browser never contacts the real server. Playwright intercepts the request instantly and hands back the fake JSON with a 200 OK status.",
            "The test fails because the route must be configured globally.",
            "The JSON payload is sent as the request body."
          ],
          "a": "The browser never contacts the real server. Playwright intercepts the request instantly and hands back the fake JSON with a 200 OK status.",
          "explanation": "`route.fulfill` completely short-circuits the network. The HTTP request never actually hits the wire. It is resolved locally by the Playwright Node.js process, making it lightning fast."
        },
        {
          "objective": "browser_network_mechanics",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You want to verify that an API returns a specific JSON payload when a user clicks the 'Checkout' button, but you do not want to assert against the UI DOM.",
          "q": "Which Playwright method allows you to wait for a specific network response and extract its body?",
          "options": [
            "page.waitForResponse()",
            "page.waitForRequest()",
            "page.waitForLoadState()",
            "page.waitForNavigation()"
          ],
          "a": "page.waitForResponse()",
          "explanation": "`page.waitForResponse()` returns a Promise that resolves with the Playwright `Response` object. You can then call `await response.json()` to parse and assert against the actual payload returned by the server."
        }
      ],
      "Medium": [
        {
          "objective": "browser_network_mechanics",
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "await page.route('**/api/data', route => {\n  const headers = route.request().headers();\n  headers['Authorization'] = 'Bearer super-secret-token';\n  route.continue({ headers });\n});",
          "q": "What is the architectural intent of this code snippet?",
          "options": [
            "It completely mocks the API response.",
            "It intercepts the outgoing request, injects an authorization header, and then allows the request to proceed normally to the real server.",
            "It blocks any request that contains an authorization header.",
            "It reads the response headers from the server."
          ],
          "a": "It intercepts the outgoing request, injects an authorization header, and then allows the request to proceed normally to the real server.",
          "explanation": "`route.continue()` tells Playwright to let the request hit the network. By passing an override object (`{ headers }`), you can dynamically rewrite outgoing traffic. This is a powerful pattern for bypassing UI logins and injecting auth tokens directly into network calls."
        },
        {
          "objective": "browser_network_mechanics",
          "type": "multi-select",
          "difficulty": "medium",
          "scenario": "You are debugging a test that passes perfectly in Chromium but fails consistently in WebKit.",
          "q": "What are common architectural differences in how WebKit handles execution compared to Chromium? (Select all that apply)",
          "options": [
            "WebKit is fundamentally single-threaded for rendering and JavaScript execution, making it highly susceptible to race conditions and strict timing issues.",
            "WebKit natively runs on the exact same engine as Google Chrome.",
            "WebKit handles specific input types (like `<input type=\"date\">` or file pickers) using completely different OS-level dialog mechanics.",
