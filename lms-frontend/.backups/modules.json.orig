      "Easy": [
        {
          "objective": "env_validation",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You clone a Playwright repository and immediately run `npx playwright test`. The runner immediately fails, stating that it cannot find the 'playwright' module.",
          "q": "What fundamental setup step was skipped?",
          "options": [
            "You must run `npm install` to download the dependencies listed in `package.json` into the `node_modules` directory.",
            "You must run `npx playwright install` to download the browsers.",
            "You need to globally install Playwright using `npm install -g playwright`.",
            "You forgot to set the `NODE_ENV` environment variable."
          ],
          "a": "You must run `npm install` to download the dependencies listed in `package.json` into the `node_modules` directory.",
          "explanation": "Cloning a repository only downloads the source code. You must explicitly run `npm install` (or `npm ci`) to download the external libraries (including Playwright itself) into your local `node_modules` folder before running any commands."
        },
        {
          "objective": "env_validation",
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "git clone https://github.com/asa/framework.git\ncd framework\nnpm install\nnpx playwright test",
          "q": "The developer followed these steps, but Playwright threw a fatal error: `browserType.launch: Executable doesn't exist at /Library/Caches/ms-playwright/chromium-1064/chrome-mac/Chromium.app`.",
          "options": [
            "The developer forgot to run `npx playwright install` to download the actual browser binaries.",
            "The developer is on an unsupported operating system.",
            "The developer must run `npm run build` before testing.",
            "The developer forgot to pass the `--headed` flag."
          ],
          "a": "The developer forgot to run `npx playwright install` to download the actual browser binaries.",
          "explanation": "While `npm install` installs the Playwright test runner (the Node.js library), it does NOT automatically download the multi-gigabyte Chromium, Firefox, and WebKit browser binaries. You must explicitly run `npx playwright install` to fetch them into your system cache."
        },
        {
          "objective": "env_validation",
          "type": "multi-select",
          "difficulty": "easy",
          "scenario": "You are a lead engineer verifying that a junior tester's local environment is pointing to the correct enterprise GitHub repository before they push code.",
          "q": "Which of the following commands will successfully output the URL of the remote Git repository? (Select all that apply)",
          "options": [
            "git remote -v",
            "git config --get remote.origin.url",
            "cat .git/config",
            "git status",
            "git branch -a"
          ],
          "a": [
            "git remote -v",
            "git config --get remote.origin.url",
            "cat .git/config"
          ],
          "explanation": "The commands `git remote -v`, querying the git config directly, or manually reading the `.git/config` file will all reveal the upstream URL. `git status` shows working tree state, and `git branch -a` shows branches, not URLs."
        },
        {
          "objective": "env_validation",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You want to verify that the Node.js version installed on your machine matches the required version specified by your team (e.g., v20.x).",
          "q": "Which CLI command verifies your active Node.js version?",
          "options": [
            "node -v",
            "npm -v",
            "npx node version",
            "node --version-check"
          ],
          "a": "node -v",
          "explanation": "The `node -v` (or `node --version`) command outputs the currently active version of the Node.js runtime. `npm -v` outputs the version of the Node Package Manager, which is versioned separately from Node itself."
        },
        {
          "objective": "env_validation",
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "{\n  \"scripts\": {\n    \"test\": \"playwright test\",\n    \"test:ui\": \"playwright test --ui\"\n  }\n}",
          "q": "Given this `package.json` block, how do you execute the UI mode using NPM?",
          "options": [
            "npm run test:ui",
            "npx test:ui",
            "npm start test:ui",
            "node test:ui"
          ],
          "a": "npm run test:ui",
          "explanation": "Scripts defined in the `package.json` `scripts` block are executed using the `npm run <script-name>` command. Using `npx` attempts to download and run an external package, which will fail here."
        }
