      }
    ],
    "tasks": [
      {
        "title": "Sandbox: Interactive Challenge",
        "hint": "Complete the code implementation"
      }
    ],
    "quizMapping": [],
    "quizPool": {
      "Easy": [
        {
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You are analyzing a webpage to write locators. You notice an element: `<button id='submit-btn' class='primary-btn active'>Submit</button>`",
          "q": "Which CSS selector safely targets this button by its unique ID?",
          "options": [
            "#submit-btn",
            ".submit-btn",
            "button[class='submit']",
            "div#submit-btn"
          ],
          "a": "#submit-btn",
          "explanation": "The `#` symbol is the CSS selector prefix for matching an HTML element's `id` attribute."
        },
        {
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "const buttons = document.querySelectorAll('.btn');",
          "q": "In the browser DOM API, what does this method return?",
          "options": [
            "A NodeList containing all elements with the class 'btn'",
            "Just the first button",
            "An array of strings",
            "A Playwright Locator"
          ],
          "a": "A NodeList containing all elements with the class 'btn'",
          "explanation": "`querySelectorAll` returns a collection of all matching DOM elements, unlike `querySelector` which only returns the first match."
        }
      ],
      "Medium": [
        {
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "The application uses deeply nested HTML. You want to target a span inside a div with class 'container', but there are many spans on the page.",
          "q": "Which CSS combinator selects only the spans that are direct children of the container?",
          "options": [
            ".container > span",
            ".container span",
            ".container + span",
            ".container ~ span"
          ],
          "a": ".container > span",
          "explanation": "The `>` symbol is the child combinator, strictly matching elements that are direct children of the parent. A space ' ' matches any descendant."
        },
        {
          "type": "multi-select",
          "difficulty": "medium",
          "scenario": "You are inspecting a legacy application that doesn't use IDs. You need to identify reliable attributes to build your locators.",
          "q": "Which of the following HTML attributes are generally safe and resilient choices for test automation? (Select all that apply)",
          "options": [
            "data-testid",
            "aria-label",
            "class (e.g., 'hover-state-active')",
            "style (e.g., 'color: red')"
          ],
          "a": [
            "data-testid",
            "aria-label"
          ],
          "explanation": "`data-testid` is specifically designed for testing, and `aria-label` ensures accessibility. Classes and styles are tied to CSS and change constantly, making them brittle."
        }
      ],
      "Hard": [
        {
          "type": "code-analysis",
          "difficulty": "hard",
          "code": "const element = document.querySelector('input[name=\"email\"]');\nelement.dispatchEvent(new Event('change'));",
          "q": "Why might a Playwright engineer need to understand this raw DOM event dispatching?",
          "options": [
            "To force a framework like React/Angular to detect a state change if a standard page.fill() fails to trigger the framework's synthetic events",
            "Because Playwright doesn't have a fill method",
            "To bypass network cors issues",
            "To speed up execution time"
          ],
          "a": "To force a framework like React/Angular to detect a state change if a standard page.fill() fails to trigger the framework's synthetic events",
          "explanation": "Sometimes complex SPAs listen to specific DOM events. If Playwright's native actions don't trigger the exact event chain the SPA expects, an SDET can use `page.evaluate` to dispatch raw DOM events."
        }
      ]
    },
    "icon": "🌱",
