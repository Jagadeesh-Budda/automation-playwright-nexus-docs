      "Hard": [
        {
          "objective": "js_execution_context",
          "type": "code-analysis",
          "difficulty": "hard",
          "code": "const handle = await page.evaluateHandle(() => document.querySelector('.dynamic-widget'));\n// ... dozens of test steps ...\nconst isVisible = await handle.evaluate(node => node.style.display !== 'none');",
          "q": "You run this test locally and it passes, but in CI it occasionally crashes with `Error: JSHandle is disposed`. What is the architectural root cause of this failure?",
