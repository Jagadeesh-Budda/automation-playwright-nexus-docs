  {
    "id": "02-js-ts-functions",
    "title": "0.2: Functions & Scope",
    "url": "courses/playwright/02-js-ts-functions",
    "group": "🌱 MODULE 0: JS/TS FOR AUTOMATION",
    "level": 0,
    "weight": 5,
    "meta": {
      "time": "15 mins",
      "type": "Concept",
      "outcome": "Understand JS functions."
    },
    "objectives": [
      {
        "id": "js_funcs",
        "title": "Create functions and scopes."
      }
    ],
    "tasks": [
      {
        "title": "Sandbox: Interactive Challenge",
        "hint": "Complete the code implementation",
        "rules": [
          {
            "type": "ast_node",
            "value": "FunctionDeclaration",
            "required": true
          }
        ]
      }
    ],
    "quizMapping": [],
    "quizPool": {
      "Easy": [
        {
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "function setup() { let token = 'abc'; }\nconsole.log(token);",
          "q": "A junior SDET writes the following code to share an auth token. Why does the test crash?",
          "options": [
            "token is out of scope and cannot be accessed outside the setup function",
            "You must use var instead of let",
            "Playwright requires tokens to be async",
            "console.log is forbidden in tests"
          ],
          "a": "token is out of scope and cannot be accessed outside the setup function",
          "explanation": "Variables declared with `let` inside a function are block-scoped and exist only within that function."
        },
        {
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You have an automated test that calculates a shopping cart total. The calculation logic is copied and pasted in 4 different test blocks.",
          "q": "How should you refactor this to prevent maintenance nightmares?",
          "options": [
            "Extract the calculation into a reusable utility function and pass the items as arguments",
            "Put the calculation in a global var",
            "Use test.step() inside each test",
            "Ignore it, copying is faster"
          ],
          "a": "Extract the calculation into a reusable utility function and pass the items as arguments",
          "explanation": "Functions allow you to encapsulate logic, making your test suites DRY (Don't Repeat Yourself)."
        }
      ],
      "Medium": [
        {
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "const login = (user) => { \n  return user.name === 'admin'; \n}",
          "q": "Which ES6 feature is being used here?",
          "options": [
            "Arrow function syntax",
            "Immediately Invoked Function Expression (IIFE)",
            "Generator function",
            "Callback hell"
          ],
          "a": "Arrow function syntax",
          "explanation": "Arrow functions provide a concise syntax and bind `this` lexically, which is very common in modern Playwright tests."
        },
        {
          "type": "scenario",
          "difficulty": "medium",
          "scenario": "You pass a callback function to `page.evaluate()` to run script inside the browser, but it throws a ReferenceError saying your test variables are undefined.",
          "q": "Why does this happen in Playwright?",
          "options": [
            "The callback executes in the browser context, which cannot access your Node.js test scope variables automatically",
            "You forgot the await keyword",
            "You must use var instead of const",
            "Playwright doesn't support callbacks"
          ],
          "a": "The callback executes in the browser context, which cannot access your Node.js test scope variables automatically",
          "explanation": "`page.evaluate` serializes the function and sends it to the browser. It does not carry your Node.js scope with it unless you pass variables as an explicit argument."
        }
      ],
      "Hard": [
        {
          "type": "code-analysis",
          "difficulty": "hard",
          "code": "const createCounter = () => {\n  let count = 0;\n  return () => { count++; return count; };\n};\nconst counter1 = createCounter();\nconst counter2 = createCounter();\ncounter1();\ncounter1();",
          "q": "What is the result of calling counter2() now, and what concept does this demonstrate?",
          "options": [
            "Returns 1; demonstrates Closures",
            "Returns 3; demonstrates Global State",
            "Returns undefined; demonstrates Lexical Scoping",
            "Throws error; demonstrates Memory Leaks"
          ],
          "a": "Returns 1; demonstrates Closures",
          "explanation": "Closures allow the inner function to remember the environment in which it was created. Each call to `createCounter` creates a new lexical environment, meaning `counter2` has its own isolated `count` starting at 0."
        }
      ]
    },
    "icon": "🌱",
    "slug": "02-js-ts-functions",
