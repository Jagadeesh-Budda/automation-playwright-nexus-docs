    "spec": {
      "tool": "@playwright/experimental-ct-react",
      "pattern": "Component Mount"
    },
    "quizPool": {
      "Easy": [
        {
          "objective": "component_testing",
          "type": "scenario",
          "difficulty": "easy",
          "q": "How does Playwright Component Testing (CT) solve this by running tests fundamentally differently than standard E2E?",
          "options": [
            "CT uses Jest.",
            "E2E navigates to a URL (`page.goto('/login')`) and tests the entire stack. Component Testing physically mounts a single, isolated React/Vue/Svelte component directly into a blank browser page (`await mount(<Button />)`), bypassing the backend and routing layers entirely.",
            "CT tests the database.",
            "CT only runs in Node.js."
          ],
          "a": "E2E navigates to a URL (`page.goto('/login')`) and tests the entire stack. Component Testing physically mounts a single, isolated React/Vue/Svelte component directly into a blank browser page (`await mount(<Button />)`), bypassing the backend and routing layers entirely.",
          "explanation": "Component testing shifts testing 'left'. You don't need to boot up a massive Docker database just to verify that a button turns red when you hover over it.",
          "scenario": "You want to test a complex React DatePicker component in isolation, without spinning up the entire Next.js backend and routing system."
        },
        {
          "objective": "component_testing",
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "import { test, expect } from '@playwright/experimental-ct-react';\nimport { Header } from './Header';\n\ntest('Header renders', async ({ mount }) => {\n  const component = await mount(<Header title=\"Hello\" />);\n  await expect(component).toContainText('Hello');\n});",
          "q": "What Playwright object is returned by the `mount` function, allowing you to interact with the component?",
          "options": [
            "A string.",
            "A standard Playwright `Locator`. It acts exactly like a Locator obtained via `page.locator()`, meaning you can use `.click()`, `.fill()`, and `expect(component).toBeVisible()` instantly.",
            "A React virtual DOM node.",
            "A Promise."
          ],
          "a": "A standard Playwright `Locator`. It acts exactly like a Locator obtained via `page.locator()`, meaning you can use `.click()`, `.fill()`, and `expect(component).toBeVisible()` instantly.",
          "explanation": "This is the genius of Playwright CT. You write tests using the exact same API (Locators, Web-First Assertions) as E2E tests, drastically reducing the learning curve compared to tools like React Testing Library."
        },
        {
          "objective": "component_testing",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You are trying to run a Component Test, but the CLI throws an error saying `test` is not defined.",
          "q": "Why can't you use the standard `@playwright/test` import for Component Testing?",
          "options": [
            "Because it is deprecated.",
            "Component testing requires a specialized test runner that understands how to compile JSX/TSX. You MUST import `test` and `expect` from the specific framework package, e.g., `@playwright/experimental-ct-react` or `@playwright/experimental-ct-vue`.",
            "Because you need to install Webpack.",
            "Because you need to use Jest."
          ],
          "a": "Component testing requires a specialized test runner that understands how to compile JSX/TSX. You MUST import `test` and `expect` from the specific framework package, e.g., `@playwright/experimental-ct-react` or `@playwright/experimental-ct-vue`.",
          "explanation": "The CT runner is a completely different beast than the E2E runner. It spins up a Vite server in the background to instantly bundle your component and its dependencies before injecting it into the Chromium instance."
        },
        {
          "objective": "component_testing",
          "type": "multi-select",
          "difficulty": "easy",
          "scenario": "You are migrating tests from React Testing Library (RTL) / JSDOM to Playwright Component Testing.",
          "q": "What physical limitations of JSDOM does Playwright CT solve by running in a real browser? (Select all that apply)",
          "options": [
            "JSDOM does not render CSS. It cannot calculate `getBoundingClientRect()` or verify if an element is physically hidden by `z-index`. Playwright uses real Chromium, so it mathematically evaluates true visual layout.",
            "JSDOM does not support advanced browser APIs like `window.matchMedia` or `IntersectionObserver` accurately. Playwright executes inside a real V8 engine.",
            "Playwright runs in Node.js.",
            "JSDOM is faster than Playwright."
          ],
          "a": [
            "JSDOM does not render CSS. It cannot calculate `getBoundingClientRect()` or verify if an element is physically hidden by `z-index`. Playwright uses real Chromium, so it mathematically evaluates true visual layout.",
            "JSDOM does not support advanced browser APIs like `window.matchMedia` or `IntersectionObserver` accurately. Playwright executes inside a real V8 engine."
          ],
