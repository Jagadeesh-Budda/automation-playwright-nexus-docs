    "id": "60-arch-debug",
    "title": "12.3: Finding Leaky Abstractions",
    "url": "courses/playwright/60-arch-debug",
    "group": "🏗️ MODULE 12: ADVANCED ARCHITECTURE",
    "level": 9,
    "weight": 15,
    "meta": {
      "time": "20 mins",
      "type": "Debug",
      "outcome": "Audit and fix violations of the 4-layer design"
