  {
    "id": "58-arch-layers",
    "title": "12.1: The 4-Layer Separation",
    "url": "courses/playwright/58-arch-layers",
    "group": "🏗️ MODULE 12: ADVANCED ARCHITECTURE",
    "level": 9,
    "weight": 5,
