  {
    "id": "48-js-execution-context",
    "title": "8.9: The JavaScript Execution Context",
    "group": "🧱 MODULE 8: ENTERPRISE PRACTICES",
    "icon": "⚡",
    "quizPool": {
      "Easy": [
        {
          "objective": "js_execution_context",
          "type": "scenario",
          "difficulty": "easy",
          "q": "How can you access this deeply nested browser object from your Node.js test script?",
          "options": [
            "It parses the test script to find syntax errors.",
            "It executes arbitrary JavaScript code directly within the browser's page context.",
            "It runs a Node.js script in a separate background thread.",
            "It evaluates whether an element is visible on the page."
          ],
          "a": "It executes arbitrary JavaScript code directly within the browser's page context.",
          "explanation": "Playwright tests run in a Node.js environment, but the application runs in a browser. `page.evaluate()` acts as a bridge, allowing you to inject and run JavaScript directly inside the browser's window object.",
          "scenario": "You need to retrieve the value of a complex `window.appState` object that only exists inside the browser's JavaScript memory."
        },
        {
          "objective": "js_execution_context",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You need to retrieve the current inner height of the browser window to verify a responsive design media query.",
          "q": "Which code snippet correctly retrieves this value from the browser?",
          "options": [
            "const height = window.innerHeight;",
            "const height = await page.evaluate(() => window.innerHeight);",
            "const height = page.innerHeight();",
            "const height = await browser.evaluate(() => innerHeight);"
          ],
          "a": "const height = await page.evaluate(() => window.innerHeight);",
          "explanation": "Because your Playwright script executes in Node.js, the `window` object does not exist natively. You must use `page.evaluate()` to run a function inside the browser where `window` is globally available, and return the result."
        },
        {
          "objective": "js_execution_context",
          "type": "multi-select",
          "difficulty": "easy",
          "scenario": "A developer is writing a test and wants to pass a complex data structure from their Node.js test script into the browser context.",
          "q": "Which of the following data types can be successfully passed as arguments into, or returned from, `page.evaluate()`? (Select all that apply)",
          "options": [
            "Strings",
            "Numbers",
            "Standard JSON Objects",
            "DOM Elements (e.g., HTMLDivElement)",
            "Functions"
          ],
          "a": [
            "Strings",
            "Numbers",
            "Standard JSON Objects"
          ],
          "explanation": "Arguments and return values must be serializable into JSON. You cannot serialize complex objects with circular references, DOM elements, or functions. If you need to handle DOM elements, you must use `evaluateHandle` or return their specific properties (like text)."
        },
        {
          "objective": "js_execution_context",
          "type": "code-analysis",
          "difficulty": "easy",
          "code": "const secretToken = 'abc-123';\nawait page.evaluate(() => {\n  window.localStorage.setItem('auth', secretToken);\n});",
          "q": "Why will this code fail with a `ReferenceError: secretToken is not defined`?",
          "options": [
            "LocalStorage is not accessible via evaluate.",
            "The variable `secretToken` exists in the Node.js context, but the function inside `evaluate()` runs in the browser context and cannot access external closures directly.",
            "The variable must be declared with `let` instead of `const`.",
            "Evaluate functions cannot be asynchronous."
          ],
          "a": "The variable `secretToken` exists in the Node.js context, but the function inside `evaluate()` runs in the browser context and cannot access external closures directly.",
          "explanation": "The function passed to `evaluate` is stringified and sent to the browser. It loses all access to variables outside its scope. To use external variables, you must explicitly pass them as an argument: `page.evaluate(token => { ... }, secretToken)`."
        },
        {
          "objective": "js_execution_context",
          "type": "scenario",
          "difficulty": "easy",
          "scenario": "You need to inject a piece of JavaScript (like a mock analytics script) into the browser *before* any of the application's native scripts have a chance to run.",
          "q": "Which Playwright method guarantees execution before the page lifecycle begins?",
          "options": [
            "page.evaluate()",
            "page.addInitScript()",
            "page.route()",
            "page.on('load')"
          ],
          "a": "page.addInitScript()",
          "explanation": "`page.addInitScript()` evaluates a given script in every frame before any of the page's own scripts are executed. It is the industry standard for mocking browser APIs or initializing global state before the app boots."
        }
      ],
      "Medium": [
        {
          "objective": "js_execution_context",
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "const bodyElement = await page.evaluate(() => {\n  return document.body;\n});\nconsole.log(bodyElement.innerHTML);",
          "q": "What will be the result of this code?",
          "options": [
            "It will print the HTML of the body tag.",
            "It will throw a serialization error or return an empty/undefined object.",
