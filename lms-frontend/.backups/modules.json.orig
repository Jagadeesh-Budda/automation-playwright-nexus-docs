    "group": "📁 MODULE 3: TEST ORGANIZATION",
    "level": 3,
    "weight": 5,
    "meta": {
      "time": "15 mins",
      "type": "Code",
      "outcome": "Group related tests."
    },
    "objectives": [
      {
        "id": "03b_describe_blocks_obj",
        "title": "Complete 3.2: Describe Blocks"
      }
    ],
    "tasks": [],
    "quizMapping": [
      {
        "objective": "03b_describe_blocks_obj",
        "weight": 100
      }
    ],
    "quizPool": {
      "Easy": [
        {
          "type": "scenario",
          "difficulty": "easy",
          "q": "How can you logically group these tests in the file so that the HTML report visually separates them into distinct sections?",
          "options": [
            "To group related tests and share hooks/configuration",
            "To execute an individual test assertion",
            "To launch a new browser instance",
            "To pause the test execution"
          ],
          "a": "To group related tests and share hooks/configuration",
          "explanation": "test.describe blocks allow you to logically group tests and share before/after hooks among them.",
          "scenario": "You have a test file with 15 tests. The first 5 test the 'Checkout' feature, and the last 10 test 'User Settings'."
        }
      ],
      "Medium": [
        {
          "type": "code-analysis",
          "difficulty": "medium",
          "code": "test.describe('Auth', () => {\n  test.beforeEach(async () => { /* login */ });\n  test('A', async () => {});\n});\ntest('B', async () => {});",
          "q": "How many times will the beforeEach hook execute during this run?",
          "options": [
            "1 time (before test A).",
            "2 times (before test A and test B).",
            "0 times.",
            "It runs once before the describe block starts."
          ],
          "a": "1 time (before test A).",
          "explanation": "Hooks declared inside a test.describe block are strictly scoped to the tests within that block. Test 'B' exists outside the block and will not trigger the hook."
        }
      ],
      "Hard": [
        {
          "type": "code-analysis",
          "difficulty": "hard",
          "code": "test.describe.configure({ mode: 'parallel' });\ntest('A', async () => {});\ntest('B', async () => {});",
          "q": "Assuming the global config does not enforce fullyParallel, what does this specific configuration block do?",
          "options": [
            "It overrides the default sequential file execution, forcing tests A and B to run concurrently in separate worker processes.",
            "It forces tests A and B to run simultaneously in the same Node.js thread using Promise.all().",
            "It tells the CI server to spawn another container.",
            "It ignores any beforeEach hooks to save time."
          ],
          "a": "It overrides the default sequential file execution, forcing tests A and B to run concurrently in separate worker processes.",
          "explanation": "By default, tests inside a single file run sequentially in the same worker. Using mode: 'parallel' inside a describe block breaks the tests apart, distributing them to separate OS-level worker processes to speed up execution."
        }
      ]
    },
    "icon": "📁",
    "slug": "20-describe-blocks",
    "learningPaths": [
      "foundations",
      "enterprise"
    ],
    "category": "core",
    "optional": false,
    "industryTags": [],
    "estimatedMinutes": 45,
    "certificateTrack": "Playwright Foundations"
  },
