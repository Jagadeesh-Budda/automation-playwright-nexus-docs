  {
    "id": "104-db-validation",
    "title": "19.3: Database Validation & Audit Trails",
    "icon": "🗄️",
    "quizPool": {
      "Easy": [
        {
          "objective": "db_validation",
          "type": "mcq",
          "difficulty": "easy",
          "q": "Why is relying solely on the UI to verify a successful action (like saving a record) insufficient in highly regulated enterprise environments (e.g., Pharma, FinTech)?",
          "options": [
            "Because the UI might be ugly.",
            "The UI can lie. A frontend bug might display a green 'Success' toast notification, but a backend failure could silently drop the SQL INSERT statement. In regulated industries, you must mathematically prove the data actually persisted to the underlying database.",
            "Because Playwright is slow.",
            "Because databases don't matter."
          ],
          "a": "The UI can lie. A frontend bug might display a green 'Success' toast notification, but a backend failure could silently drop the SQL INSERT statement. In regulated industries, you must mathematically prove the data actually persisted to the underlying database.",
          "explanation": "Visual validation is superficial. Enterprise automation requires 'Deep Validation'. The test must physically reach into the backend state machine to verify the structural integrity of the data."
        },
        {
          "objective": "db_validation",
