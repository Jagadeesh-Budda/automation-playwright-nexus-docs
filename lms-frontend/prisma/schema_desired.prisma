generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String   @default("Student")
  role                String   @default("student")
  otp                 String?
  otpExpiry           DateTime?
  learningPreferences Json?
  lastActivityDate    String?
  todayMinutes        Int      @default(0)
  totalMinutes        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  userProgress  UserProgress[]
  certificates  Certificate[]
  events        MasteryEvent[]
  refreshTokens RefreshToken[]
}

model Progress {
  id        String   @id @default(uuid())
  userId    String   @unique
  state     String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProgress {
  id                String   @id @default(uuid())
  user_id           String
  module_id         String
  score             Int      @default(0)
  attempts          Int      @default(0)
  failed_objectives String   
  lockedUntil       DateTime?
  version           String   @default("1.5.0")

  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, module_id])
}

model Certificate {
  id                   String   @id @default(uuid())
  certId               String   @unique
  name                 String
  path                 String   @default("all")
  completionPercentage Int      @default(100)
  signature            String
  status               String   @default("ACTIVE")
  issuedAt             DateTime @default(now())
  user_id              String?
  hash_signature       String?  @unique
  validation_url       String?

  user User? @relation(fields: [user_id], references: [id])
}

model IdempotencyKey {
  key       String   @id
  userId    String
  createdAt DateTime @default(now())
}

model MasteryEvent {
  id        String   @id @default(uuid())
  type      String
  userId    String
  moduleId  String?
  payload   String   
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── Revision Center Tables ──────────────────────────────────────────────────

model UserBookmark {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
}

// Multiple notes allowed per lesson — no unique constraint on (userId, lessonId)
model UserNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  title     String   @default("Untitled note")
  content   String
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, lessonId])
}

model UserHighlight {
  id              String   @id @default(cuid())
  userId          String
  lessonId        String
  paragraphId     String
  anchorText      String
  focusText       String
  // occurrenceIndex disambiguates identical text appearing multiple times in the same paragraph
  occurrenceIndex Int      @default(0)
  color           String   @default("yellow")
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([userId, lessonId])
}

model RevisionSchedule {
  id                  String   @id @default(cuid())
  userId              String
  lessonId            String
  interval            Int      @default(1)   // days until next review
  repetitions         Int      @default(0)
  easeFactor          Float    @default(2.5)
  nextReview          DateTime @default(now())
  lastScore           Int      @default(0)   // 0-5 confidence rating
  // Lesson version tracking — auto-flag for re-review when course content changes
  lessonVersion       Int      @default(1)   // current version from metadata.json
  lastReviewedVersion Int      @default(1)   // version at time of last user review
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([userId, nextReview])
}

/// Study sessions: track active study time per lesson/user
model StudySession {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String?
  minutes   Int
  startedAt DateTime
  endedAt   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([lessonId])
}
