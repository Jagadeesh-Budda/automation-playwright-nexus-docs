      "quizPool": {
        "Easy": [
          {
            "type": "mcq",
            "difficulty": "easy",
            "q": "What does a 'strict mode violation' mean in Playwright?",
            "options": [
              "A locator matched more than one element",
              "A locator matched zero elements",
              "The code has a TypeScript syntax error",
              "The element is not visible"
            ],
            "a": "A locator matched more than one element",
            "explanation": "Playwright enforces strict mode by default, throwing an error if a locator resolves to multiple elements instead of one."
          }
        ],
        "Medium": [
          {
            "type": "code-analysis",
            "difficulty": "medium",
            "code": "await page.locator('button').click();",
            "q": "If there are 3 buttons on the page, what will Playwright do when this line executes?",
            "options": [
              "It will throw a strict mode violation error because the locator resolved to multiple elements.",
              "It will automatically click the first button it finds.",
              "It will click all 3 buttons simultaneously.",
              "It will wait 30 seconds for 2 of the buttons to disappear."
            ],
            "a": "It will throw a strict mode violation error because the locator resolved to multiple elements.",
            "explanation": "Unlike Selenium or Cypress which default to the 'first' element, Playwright enforces strict mode for actions. If an action locator is ambiguous, it intentionally throws an error to prevent accidental interactions with the wrong element."
          }
        ],
        "Hard": [
          {
            "type": "code-analysis",
            "difficulty": "hard",
            "code": "await page.locator('div').filter({ hasText: 'Submit' }).click();",
            "q": "Why might this specific locator approach still trigger a strict mode violation on a complex web page?",
            "options": [
              "Because hasText matches substrings. If the page contains nested divs (e.g. a container div holding the button div), both the parent and child div contain the text, returning multiple elements.",
              "Because filter() is an asynchronous function that must be awaited.",
              "Because hasText is case-sensitive and 'Submit' might be lowercase.",
              "Because you cannot chain .click() directly after .filter()."
            ],
            "a": "Because hasText matches substrings. If the page contains nested divs (e.g. a container div holding the button div), both the parent and child div contain the text, returning multiple elements.",
            "explanation": "Text filters match the entire subtree. If a <div class=\"container\"> wraps a <div class=\"btn\">Submit</div>, Playwright sees that BOTH divs contain the text 'Submit', leading to an ambiguous locator error."
          }
        ]
      },
