      "quizPool": {
        "Easy": [
          {
            "type": "scenario",
            "difficulty": "easy",
            "q": "If the Page Object Model (POM) pattern had been used, how would resolving this failure be different?",
            "options": [
              "It encapsulates page-specific logic and locators for better maintainability",
              "It makes the test run significantly faster",
              "It automatically generates assertions",
              "It prevents network errors"
            ],
            "a": "It encapsulates page-specific logic and locators for better maintainability",
            "explanation": "POM isolates page elements and actions, reducing duplication and making UI changes easier to handle.",
            "scenario": "The developer changes the ID of the login button from '#login-btn' to '#submit-auth'. 45 of your UI tests immediately fail."
          }
        ],
        "Medium": [
          {
            "type": "scenario",
            "difficulty": "medium",
            "scenario": "The UI team changes the ID of the login button from #btn-login to #submit-login. Your test suite has 50 tests that click this button.",
            "q": "If you are using the POM pattern, how many files do you need to modify?",
            "options": [
              "Exactly 1 file (the LoginPage class).",
              "50 files (every test that uses the button).",
              "0 files (Playwright automatically finds the new button).",
              "You must update the playwright.config.ts file."
            ],
            "a": "Exactly 1 file (the LoginPage class).",
            "explanation": "This is the primary value proposition of POM. The locator is defined centrally in the Page Object class. When the UI changes, you update the single source of truth, and all 50 tests inherit the fix automatically."
          }
        ],
        "Hard": [
          {
            "type": "code-analysis",
            "difficulty": "hard",
            "q": "What is a known anti-pattern when implementing the Page Object Model in Playwright?",
            "options": [
              "Including assertions (e.g., expect(page).toHaveTitle()) directly inside the Page Object methods.",
              "Passing the page fixture into the constructor of the class.",
              "Creating methods that return locators instead of executing actions.",
              "Typing the class properties as Locator."
            ],
            "a": "Including assertions (e.g., expect(page).toHaveTitle()) directly inside the Page Object methods.",
            "explanation": "Page Objects should represent the *state* and *actions* of the page, not the *intent* of the test. Burying assertions inside POM methods hides test logic, makes debugging difficult, and reduces the reusability of the action methods. Assertions belong in the .spec.ts files."
          }
        ]
      },
